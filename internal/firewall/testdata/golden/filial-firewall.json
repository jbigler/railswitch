{
  "version": "1.0.0",
  "hook": {
    "path": "/WORKSPACES/filial/.railswitch/firewall/hook.sh",
    "args": [
      "hook.sh",
      "filial",
      "/WORKSPACES/filial/.railswitch/firewall"
    ],
    "env": [
      "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
      "NETWORK_DIR=/home/u/.local/share/containers/storage/networks"
    ],
    "timeout": 60
  },
  "when": {
    "annotations": {
      "^filial\\.firewall$": ".*"
    }
  },
  "stages": [
    "createRuntime"
  ]
}
