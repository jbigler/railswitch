# Agent base: extends the worktree's base image for every agent package, with
# the tools agents and their entrypoints use. railswitch passes BASE_IMAGE, the
# base chain's last image (D31), and builds each agent's Containerfile on this.
# It uses apt-get: a base image that is not Debian-based needs this file edited
# (railswitch containerfile eject agent-base).
ARG BASE_IMAGE

# The GitHub CLI from GitHub's own package repository (Debian's is too old
# for gh skill), its current release on every build: the ADD of its latest
# release's record, fetched on every build (its download counts change),
# runs the install again despite the layer cache, as lazygit's does (D163,
# D169). gh is one static binary; the final stage copies it in as its last
# step, so a build reruns only that step, and only when gh changed.
FROM docker.io/library/debian:trixie-slim AS gh
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && \
  apt-get install -y --no-install-recommends ca-certificates curl && \
  install -d -m 0755 /etc/apt/keyrings && \
  curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg -o /etc/apt/keyrings/githubcli-archive-keyring.gpg && \
  chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg && \
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list && \
  rm -rf /var/lib/apt/lists/*
ADD https://api.github.com/repos/cli/cli/releases/latest /tmp/gh-latest.json
RUN apt-get update -qq && apt-get install -y --no-install-recommends gh && \
  rm -rf /var/lib/apt/lists/*

FROM ${BASE_IMAGE}
USER root
RUN apt-get update -qq && \
  apt-get install --no-install-recommends -y git curl ca-certificates jq ripgrep fd-find socat openssh-client less procps tmux && \
  rm -rf /var/lib/apt/lists/*
# gh (the gh stage): agents get a github.com secret as GH_TOKEN (D133).
COPY --from=gh /usr/bin/gh /usr/local/bin/gh
USER appuser
