# Agent base: extends the worktree's base image for every agent package, with
# the tools agents and their entrypoints use. railswitch passes BASE_IMAGE, the
# base chain's last image (D31), and builds each agent's Containerfile on this.
# It uses apt-get: a base image that is not Debian-based needs this file edited
# (railswitch containerfile eject agent-base).
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
USER root
RUN apt-get update -qq && \
  apt-get install --no-install-recommends -y git curl ca-certificates jq ripgrep fd-find socat openssh-client less procps && \
  rm -rf /var/lib/apt/lists/*
# The GitHub CLI from GitHub's own package repository (Debian's is too old for
# gh skill): agents get a github.com secret as GH_TOKEN (D133).
RUN install -d -m 0755 /etc/apt/keyrings && \
  curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg -o /etc/apt/keyrings/githubcli-archive-keyring.gpg && \
  chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg && \
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list && \
  apt-get update -qq && apt-get install --no-install-recommends -y gh && \
  rm -rf /var/lib/apt/lists/*
# Shared agent memory (D136): beads' bd, only in a project with [memory]
# (railswitch passes MEMORY=1), pinned and checked against the sha256 of
# the release's checksums.txt. Every agent image of a project must run one
# bd version: bd refuses a database a newer bd migrated (railswitch doctor
# checks the labels below against this pin).
ARG MEMORY=
ARG BD_VERSION=1.3.2
ARG BD_SHA256_AMD64=c6ea3281f6ff82628351b2d0967c9eb85862c8a0ec0ebc24e63e645c8b02462e
ARG BD_SHA256_ARM64=39b34a1246b7216031a98ae838c785a7dbba29cf9f50f109114ac462a4b85e7c
RUN if [ -n "$MEMORY" ]; then \
    arch="$(dpkg --print-architecture)" && \
    case "$arch" in \
      amd64) sum="$BD_SHA256_AMD64" ;; \
      arm64) sum="$BD_SHA256_ARM64" ;; \
      *) echo "bd: no release for $arch" >&2; exit 1 ;; \
    esac && \
    tgz="beads_${BD_VERSION}_linux_${arch}.tar.gz" && \
    curl -fsSL -o "/tmp/$tgz" "https://github.com/gastownhall/beads/releases/download/v${BD_VERSION}/$tgz" && \
    echo "$sum  /tmp/$tgz" | sha256sum -c - && \
    tar -xzf "/tmp/$tgz" -C /usr/local/bin bd && \
    chmod 755 /usr/local/bin/bd && rm "/tmp/$tgz"; \
  fi
LABEL railswitch.memory="${MEMORY}" railswitch.bd.version="${BD_VERSION}"
USER appuser
