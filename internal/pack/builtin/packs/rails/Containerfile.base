# The rails pack's default base image (D31): app, deps and worker run it, and
# every addon and tool image is built on top of it. railswitch passes
# RUBY_VERSION, NODE_VERSION and BUN_VERSION from the worktree's own version
# files; BUN_VERSION is empty unless the app pins bun (D69).
#
# Database clients are not here: the database option's addon adds them
# (postgres: Containerfile.pg-client). Nothing is read from the build context.
ARG RUBY_VERSION
ARG NODE_VERSION
ARG BUN_VERSION

# Node, only to copy its runtime into the image below.
FROM docker.io/library/node:${NODE_VERSION}-slim AS node

FROM docker.io/library/ruby:${RUBY_VERSION}-slim

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG BUN_VERSION

# What a Rails app needs to build its gems and run: compilers and headers for
# native extensions, git for git-sourced gems, curl for the health check,
# libvips for Active Storage variants, jemalloc for a smaller Ruby heap.
RUN apt-get update -qq && \
  apt-get install --no-install-recommends -y \
  build-essential \
  ca-certificates \
  curl \
  git \
  libffi-dev \
  libjemalloc2 \
  libssl-dev \
  libvips \
  libyaml-dev \
  openssh-client \
  pkg-config \
  sqlite3 \
  tzdata \
  zlib1g-dev && \
  rm -rf /var/lib/apt/lists/* && \
  ln -s "/usr/lib/$(uname -m)-linux-gnu/libjemalloc.so.2" /usr/local/lib/libjemalloc.so

ENV LD_PRELOAD=/usr/local/lib/libjemalloc.so

COPY --from=node /usr/local/bin /usr/local/bin
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules

# yarn and pnpm through corepack, at the version package.json's
# "packageManager" names. Node 25 and later no longer ship corepack, so it
# comes from npm there. Without a prompt: deps runs unattended; without
# auto-pin: corepack never writes "packageManager" into the app's
# package.json. The node image's yarn and yarnpkg links point into its /opt,
# which is not copied: corepack cannot replace a dangling link, so they go
# first.
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
ENV COREPACK_ENABLE_AUTO_PIN=0
RUN rm -f /usr/local/bin/yarn /usr/local/bin/yarnpkg && \
  if ! command -v corepack >/dev/null; then npm install -g --no-audit --no-fund corepack; fi && \
  corepack enable

# bun, only when the app pins it (.bun-version or "packageManager": "bun@…").
RUN if [ -n "${BUN_VERSION}" ]; then \
    case "$(uname -m)" in x86_64) arch=x64 ;; aarch64) arch=aarch64 ;; *) echo "bun: no build for $(uname -m)" >&2; exit 1 ;; esac && \
    apt-get update -qq && apt-get install --no-install-recommends -y unzip && rm -rf /var/lib/apt/lists/* && \
    curl -fsSL -o /tmp/bun.zip "https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/bun-linux-${arch}.zip" && \
    unzip -q -j /tmp/bun.zip -d /usr/local/bin && rm /tmp/bun.zip && \
    ln -s bun /usr/local/bin/bunx; \
  fi

RUN gem update --system && \
  gem install -N bundler

# appuser is uid/gid 1000: keep-id maps the host user onto it. The directories
# volumes are mounted on exist and belong to appuser, so a fresh volume copies
# up appuser ownership; a parent the runtime had to create for a nested mount
# would belong to root and nothing else could write there.
RUN groupadd --gid 1000 appuser && \
  useradd --uid 1000 --gid 1000 --shell /bin/bash --create-home appuser && \
  mkdir -p /app \
  /usr/local/bundle \
  /home/appuser/.npm \
  /home/appuser/.npm-global && \
  chown -R 1000:1000 /app /usr/local/bundle /home/appuser

ENV NPM_CONFIG_PREFIX=/home/appuser/.npm-global
ENV PATH=/home/appuser/.local/bin:/home/appuser/.npm-global/bin:${PATH}:/app/node_modules/.bin
ENV SHELL=/bin/bash

WORKDIR /app
USER appuser

EXPOSE 3000
CMD ["bin/dev"]
