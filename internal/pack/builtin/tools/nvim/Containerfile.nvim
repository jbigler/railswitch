# nvim tool (D23): a headless Neovim server on the worktree's base image, so
# the editor sees the app's runtimes and OS packages. railswitch passes
# BASE_IMAGE, the base chain's last image (D31). No agent software (D30).
ARG BASE_IMAGE
# Node for language servers installed with npm (D71). It is used only when
# the base image has no npm (a bun-only image answers `node` with bun, but
# has no npm); a base with Node keeps the app's. Change it here; then remove
# the <prefix>_npm_global_node volume, whose packages were built for the old one.
ARG NVIM_NODE_VERSION=24

FROM docker.io/library/node:${NVIM_NODE_VERSION}-slim AS nvim-node

# Neovim, built from source.
FROM docker.io/library/debian:trixie-slim AS build-nvim

ARG DEBIAN_FRONTEND=noninteractive
ARG TARGET=stable

RUN apt-get update -qq && \
  apt-get install -y --no-install-recommends \
  autoconf \
  automake \
  binutils \
  build-essential \
  ca-certificates \
  cmake \
  curl \
  g++ \
  gettext \
  git \
  libtool \
  libtool-bin \
  ninja-build \
  pkg-config \
  unzip && \
  rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch "${TARGET}" https://github.com/neovim/neovim.git /tmp/neovim

WORKDIR /tmp/neovim

RUN make CMAKE_BUILD_TYPE=RelWithDebInfo CMAKE_INSTALL_PREFIX=/usr/local/ && \
  make install && \
  strip /usr/local/bin/nvim

# Release binaries for amd64 or arm64, each checked before install:
# lazygit (most configs bind it to <leader>gg) against its release's
# checksums.txt; the tree-sitter CLI (nvim-treesitter builds parsers with
# it) against the SHA-256s below, as GitHub lists them for the release's
# assets (it publishes no checksums file). Debian's tree-sitter-cli is older
# than nvim-treesitter needs, and bookworm has none. On a bookworm base
# (glibc 2.36) tree-sitter prints a loader warning about GLIBC_2.39 each
# run: Rust's standard library links pidfd_spawnp/pidfd_getpid weakly and
# falls back without them, so it works.
FROM docker.io/library/debian:trixie-slim AS downloads
ARG DEBIAN_FRONTEND=noninteractive
ARG LAZYGIT_VERSION=0.66.2
ARG TREE_SITTER_VERSION=0.27.1
ARG TREE_SITTER_SHA256_X64=d01042f94ba3d6827ddc9788e235f75d8366431be42bdf90ade534d960c98b7d
ARG TREE_SITTER_SHA256_ARM64=404be5d54a4955571c4067c21d4699660eab3a534cefb0659341b207f7139ec5
RUN apt-get update -qq && \
  apt-get install -y --no-install-recommends ca-certificates curl && \
  rm -rf /var/lib/apt/lists/*
RUN case "$(dpkg --print-architecture)" in \
    amd64) LG=x86_64; TS=x64; TS_SHA="${TREE_SITTER_SHA256_X64}" ;; \
    arm64) LG=arm64; TS=arm64; TS_SHA="${TREE_SITTER_SHA256_ARM64}" ;; \
    *) echo "unsupported architecture: $(dpkg --print-architecture)" >&2; exit 1 ;; \
  esac && \
  cd /tmp && \
  LG_FILE="lazygit_${LAZYGIT_VERSION}_linux_${LG}.tar.gz" && \
  LG_URL="https://github.com/jesseduffield/lazygit/releases/download/v${LAZYGIT_VERSION}" && \
  curl -fsSLO "${LG_URL}/${LG_FILE}" && \
  curl -fsSL "${LG_URL}/checksums.txt" | grep " ${LG_FILE}\$" | sha256sum -c - && \
  tar -xzf "${LG_FILE}" lazygit && \
  install -m 755 lazygit /usr/local/bin/lazygit && \
  TS_FILE="tree-sitter-linux-${TS}.gz" && \
  curl -fsSLO "https://github.com/tree-sitter/tree-sitter/releases/download/v${TREE_SITTER_VERSION}/${TS_FILE}" && \
  echo "${TS_SHA}  ${TS_FILE}" | sha256sum -c - && \
  gunzip "${TS_FILE}" && \
  install -m 755 "tree-sitter-linux-${TS}" /usr/local/bin/tree-sitter

FROM ${BASE_IMAGE}
USER root

COPY --from=build-nvim /usr/local/bin/nvim /usr/local/bin/nvim
COPY --from=build-nvim /usr/local/lib/nvim /usr/local/lib/nvim
COPY --from=build-nvim /usr/local/share/nvim /usr/local/share/nvim
COPY --from=downloads /usr/local/bin/lazygit /usr/local/bin/tree-sitter /usr/local/bin/

# nvim's own Node in /opt/nvim-node, linked into /usr/local/bin (ahead of a
# bun image's node fallback in PATH) only when the base has no npm.
COPY --from=nvim-node /usr/local/bin/node /opt/nvim-node/bin/node
COPY --from=nvim-node /usr/local/lib/node_modules /opt/nvim-node/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /opt/nvim-node/bin/npm && \
  ln -s ../lib/node_modules/npm/bin/npx-cli.js /opt/nvim-node/bin/npx && \
  if ! command -v npm >/dev/null 2>&1; then \
    ln -sf /opt/nvim-node/bin/node /opt/nvim-node/bin/npm /opt/nvim-node/bin/npx /usr/local/bin/; \
  fi

# Editor tooling: search, fuzzy finding, tags, clipboard, Lua for plugins.
RUN apt-get update -qq && \
  apt-get install --no-install-recommends -y \
  fd-find \
  fzf \
  lua5.4 \
  luarocks \
  netbase \
  openssh-client \
  ripgrep \
  universal-ctags \
  unzip \
  xclip && \
  rm -rf /var/lib/apt/lists/*

# The volumes mounted under ~ need their parents to belong to appuser.
RUN mkdir -p /home/appuser/.config /home/appuser/.local/share /home/appuser/.npm-global && \
  chown -R 1000:1000 /home/appuser/.config /home/appuser/.local /home/appuser/.npm-global

# `npm install -g` goes to the shared npm volume, whatever the base sets.
ENV NPM_CONFIG_PREFIX=/home/appuser/.npm-global
ENV PATH=/home/appuser/.npm-global/bin:${PATH}

USER appuser

EXPOSE 7777
CMD ["/usr/local/bin/nvim", "--headless", "--listen", "0.0.0.0:7777"]
