PublishPort=127.0.0.1:19002:9000
Volume=filial-feat-rustfs-data:/data
NoNewPrivileges=true
Memory=2g
PidsLimit=1024
Label=traefik.enable=true
Label=traefik.docker.network=filial_proxy
