# railswitch: rendered from /WORKSPACES/filial/project.toml (prefix filial, worktree master). Edit project.toml, not this file.
# role: deps

[Unit]
Description=filial deps of worktree master

[Container]
Label=filial.unit-hash=6aeaa784739f
Image=localhost/filial/base:ruby3.3.6-node22.11.0-5fcbbafc
ContainerName=filial-master-deps
Network=filial-master-dev.network:alias=deps
UserNS=keep-id:uid=1000,gid=1000
User=1000:1000
EnvironmentFile=/WORKSPACES/filial/.railswitch/env/master/deps.env
Volume=/WORKSPACES/filial/master:/app:z
Volume=/WORKSPACES/filial/master/.git:/app/.git:ro,z
Volume=/WORKSPACES/filial/master/.git/hooks:/app/.git/hooks:ro,z
Volume=/WORKSPACES/filial/.railswitch/assets/rails/entrypoints/entrypoint-deps.sh:/usr/local/bin/entrypoint-deps.sh:ro,z
Volume=filial_gems_ruby3.3.6:/usr/local/bundle
Volume=filial_npm_cache:/home/appuser/.npm:U
Volume=filial-master-node-modules:/app/node_modules:U
DropCapability=all
NoNewPrivileges=true
Memory=4g
PidsLimit=4096
GlobalArgs=--hooks-dir=/WORKSPACES/filial/.railswitch/firewall/hooks.d
Annotation=filial.firewall=deps
Annotation=filial.firewall.networks=filial-master-dev
Annotation=filial.firewall.mode=log
PodmanArgs=--cpus=6
LogDriver=passthrough
Entrypoint=/usr/local/bin/entrypoint-deps.sh

[Service]
Type=oneshot
TimeoutStartSec=900
