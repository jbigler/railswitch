# railswitch: rendered from /WORKSPACES/filial/project.toml (prefix filial, worktree master). Edit project.toml, not this file.
# role: tool

[Unit]
Description=filial nvim of worktree master

[Container]
Label=filial.unit-hash=a409dec71138
Image=localhost/filial/nvim:ruby3.3.6-node22.11.0-8b570477
ContainerName=filial-master-nvim
Network=filial-master-dev.network:alias=nvim
Network=filial-proxy.network
UserNS=keep-id:uid=1000,gid=1000
User=1000:1000
EnvironmentFile=/WORKSPACES/filial/.railswitch/env/master/nvim.env
AddHost=master.filial.localhost:10.214.3.2
AddHost=s3.master.filial.localhost:10.214.3.2
AddHost=s3-ui.master.filial.localhost:10.214.3.2
AddHost=vnc.master.filial.localhost:10.214.3.2
PublishPort=127.0.0.1:17001:7777
Volume=/WORKSPACES/filial/master:/app:z
Volume=/WORKSPACES/filial/master:/WORKSPACES/filial/master:z
Volume=/WORKSPACES/filial/master/.git:/WORKSPACES/filial/master/.git:z
Volume=/WORKSPACES/filial/master/.git/hooks:/WORKSPACES/filial/master/.git/hooks:ro,z
Volume=/WORKSPACES/filial/master/.git:/app/.git:z
Volume=/WORKSPACES/filial/master/.git/hooks:/app/.git/hooks:ro,z
Volume=/WORKSPACES/filial/.railswitch/home/master:/home/appuser:z
Volume=/WORKSPACES/filial/.railswitch/assets/nvim/entrypoints/entrypoint-nvim.sh:/usr/local/bin/entrypoint-nvim.sh:ro,z
Volume=filial-master-node-modules:/app/node_modules:U
Volume=filial_gems_ruby3.3.6:/usr/local/bundle
Volume=filial_npm_cache:/home/appuser/.npm:U
Volume=filial_nvim_config:/home/appuser/.config/nvim:U
Volume=filial_nvim_share:/home/appuser/.local/share/nvim:U
Volume=filial_npm_global_node22.11.0:/home/appuser/.npm-global:U
Secret=filial_github_token,type=mount,target=/run/secrets/github_token,uid=1000,gid=1000,mode=0400
DropCapability=all
NoNewPrivileges=true
Memory=2g
PidsLimit=4096
GlobalArgs=--hooks-dir=/WORKSPACES/filial/.railswitch/firewall/hooks.d
Annotation=filial.firewall=agent,deps
Annotation=filial.firewall.networks=filial-master-dev,filial_proxy
Annotation=filial.firewall.mode=enforce
Annotation=filial.firewall.extra=api.github.com,raw.githubusercontent.com,pypi.org,files.pythonhosted.org,github.com
PodmanArgs=--cpus=2 --tty --interactive
LogDriver=journald
Entrypoint=/usr/local/bin/entrypoint-nvim.sh
Exec=/usr/local/bin/nvim --headless --listen 0.0.0.0:7777

[Service]
Restart=on-failure
RestartSec=5
SuccessExitStatus=1
