# railswitch: rendered from /WORKSPACES/filial/project.toml (prefix filial, worktree master). Edit project.toml, not this file.
# role: app

[Unit]
Description=filial rails of worktree master
Requires=filial-master-deps.service filial-master-db.service filial-master-cache.service filial-master-storage.service
Wants=filial-master-browser.service filial-master-nvim.service railswitch-traefik.service
After=filial-master-deps.service filial-master-db.service filial-master-cache.service filial-master-storage.service filial-master-browser.service filial-master-nvim.service railswitch-traefik.service

[Container]
Label=filial.unit-hash=6290a2633000
Image=localhost/filial/base:ruby3.3.6-node22.11.0-53f4a85e
ContainerName=filial-master-rails
Network=filial-master-dev.network:alias=rails
Network=filial-proxy.network
UserNS=keep-id:uid=1000,gid=1000
User=1000:1000
EnvironmentFile=/WORKSPACES/filial/.railswitch/env/master/rails.env
AddHost=master.filial.localhost:10.214.3.2
AddHost=s3.master.filial.localhost:10.214.3.2
AddHost=s3-ui.master.filial.localhost:10.214.3.2
AddHost=vnc.master.filial.localhost:10.214.3.2
PublishPort=127.0.0.1:33001:33001
PublishPort=127.0.0.1:13001:3000
Volume=/WORKSPACES/filial/master:/app:z
Volume=/WORKSPACES/filial/master/.git:/WORKSPACES/filial/master/.git:ro,z
Volume=/WORKSPACES/filial/.railswitch/assets/rails/entrypoints/entrypoint-app.sh:/usr/local/bin/entrypoint-app.sh:ro,z
Volume=filial_gems_ruby3.3.6:/usr/local/bundle
Volume=filial_npm_cache:/home/appuser/.npm:U
Volume=filial-master-node-modules:/app/node_modules:U
Secret=filial_twilio_auth_token,type=env,target=TWILIO_AUTH_TOKEN
DropCapability=all
NoNewPrivileges=true
Memory=4g
PidsLimit=4096
Label=traefik.enable=true
Label=traefik.docker.network=filial_proxy
Label=traefik.http.routers.filial-master-app.rule=Host(`master.filial.localhost`)
Label=traefik.http.routers.filial-master-app.entrypoints=web
Label=traefik.http.routers.filial-master-app.service=filial-master-app
Label=traefik.http.services.filial-master-app.loadbalancer.server.port=3000
HealthCmd=curl -fsS http://localhost:3000/up
HealthInterval=10s
HealthRetries=3
HealthStartPeriod=120s
Notify=healthy
GlobalArgs=--hooks-dir=/WORKSPACES/filial/.railswitch/firewall/hooks.d
Annotation=filial.firewall=none
Annotation=filial.firewall.networks=filial-master-dev,filial_proxy
Annotation=filial.firewall.mode=log
PodmanArgs=--cpus=6
LogDriver=k8s-file
LogOpt=max-size=20m
Entrypoint=/usr/local/bin/entrypoint-app.sh
Exec=bin/dev

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
