# railswitch: rendered from /WORKSPACES/minimal/project.toml (prefix mini, worktree master). Edit project.toml, not this file.
# role: deps

[Unit]
Description=mini deps of worktree master

[Container]
Label=mini.unit-hash=08265b2d101d
Image=localhost/mini/base:ruby3.3.6-node22.11.0-39fced4e
ContainerName=mini-master-deps
Network=mini-master-dev.network:alias=deps
UserNS=keep-id:uid=1000,gid=1000
User=1000:1000
EnvironmentFile=/WORKSPACES/minimal/.railswitch/env/master/deps.env
Volume=/WORKSPACES/minimal/master:/app:z
Volume=/WORKSPACES/minimal/master/.git:/app/.git:ro,z
Volume=/WORKSPACES/minimal/master/.git/hooks:/app/.git/hooks:ro,z
Volume=/WORKSPACES/minimal/.railswitch/assets/rails/entrypoints/entrypoint-deps.sh:/usr/local/bin/entrypoint-deps.sh:ro,z
Volume=mini_gems_ruby3.3.6:/usr/local/bundle
Volume=mini_npm_cache:/home/appuser/.npm:U
Volume=mini_corepack:/home/appuser/.corepack:U
Volume=mini-master-node-modules:/app/node_modules:U
DropCapability=all
NoNewPrivileges=true
Memory=4g
PidsLimit=4096
GlobalArgs=--hooks-dir=/WORKSPACES/minimal/.railswitch/firewall/hooks.d
Annotation=mini.firewall=deps
Annotation=mini.firewall.networks=mini-master-dev
Annotation=mini.firewall.mode=log
Annotation=mini.firewall.lists=1b43b4632158
PodmanArgs=--cpus=6
LogDriver=passthrough
Entrypoint=/usr/local/bin/entrypoint-deps.sh

[Service]
Type=oneshot
TimeoutStartSec=900

[Quadlet]
DefaultDependencies=false
