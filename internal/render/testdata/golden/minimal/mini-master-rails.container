# railswitch: rendered from /WORKSPACES/minimal/project.toml (prefix mini, worktree master). Edit project.toml, not this file.
# role: app

[Unit]
Description=mini rails of worktree master
Requires=mini-master-deps.service
Wants=railswitch-traefik.service railswitch-dozzle.service
After=mini-master-deps.service railswitch-traefik.service railswitch-dozzle.service

[Container]
Label=mini.unit-hash=9a0a7a8d842d
Image=localhost/mini/base:ruby3.3.6-node22.11.0-bb30b09f
ContainerName=mini-master-rails
Network=mini-master-dev.network:alias=rails
Network=mini-proxy.network
UserNS=keep-id:uid=1000,gid=1000
User=1000:1000
EnvironmentFile=/WORKSPACES/minimal/.railswitch/env/master/rails.env
AddHost=master.mini.localhost:10.214.3.2
PublishPort=127.0.0.1:33001:33001
PublishPort=127.0.0.1:13001:3000
Volume=/WORKSPACES/minimal/master:/app:z
Volume=/WORKSPACES/minimal/master/.git:/WORKSPACES/minimal/master/.git:ro,z
Volume=/WORKSPACES/minimal/master/.git/hooks:/app/.git/hooks:ro,z
Volume=/WORKSPACES/minimal/.railswitch/assets/rails/entrypoints/entrypoint-app.sh:/usr/local/bin/entrypoint-app.sh:ro,z
Volume=mini_gems_ruby3.3.6:/usr/local/bundle
Volume=mini_npm_cache:/home/appuser/.npm:U
Volume=mini-master-node-modules:/app/node_modules:U
DropCapability=all
NoNewPrivileges=true
Memory=4g
PidsLimit=4096
Label=traefik.enable=true
Label=traefik.docker.network=mini_proxy
