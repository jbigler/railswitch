Label=traefik.http.routers.mini-master-app.entrypoints=web
Label=traefik.http.routers.mini-master-app.service=mini-master-app
Label=traefik.http.services.mini-master-app.loadbalancer.server.port=3000
HealthCmd=curl -fsS http://localhost:3000/up
HealthInterval=10s
HealthRetries=3
HealthStartPeriod=120s
Notify=healthy
GlobalArgs=--hooks-dir=/WORKSPACES/minimal/.railswitch/firewall/hooks.d
Annotation=mini.firewall=none
Annotation=mini.firewall.networks=mini-master-dev,mini_proxy
Annotation=mini.firewall.mode=log
PodmanArgs=--cpus=6
LogDriver=k8s-file
LogOpt=max-size=20m
Entrypoint=/usr/local/bin/entrypoint-app.sh
Exec=bin/dev

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
