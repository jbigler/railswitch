{{define "detail"}}<section id="detail" class="detail" data-slug="{{.Slug}}" data-tasks="{{.TasksURL}}">
{{if .Empty}}<p class="note">No worktree selected.</p>
{{else}}<div class="d-head">
<div class="d-title"><h1>{{.Slug}}</h1>
<div class="d-meta">{{if and .Branch (ne .Branch .Slug)}}<span class="mono br" title="branch">⎇ {{.Branch}}</span>{{end}}<span class="pill {{.StackClass}}">{{.StackGlyph}} {{.StackText}}</span>{{if .Stale}}<span class="pill stale">restart to apply</span>{{end}}{{with .PR}}{{if .URL}}<a class="pill pr-line {{.StateClass}}" href="{{.URL}}" target="_blank" rel="noopener" title="{{.Title}}">{{.Line}}</a>{{else}}<span class="pill {{.StateClass}}">{{.Line}}</span>{{end}}{{end}}{{with .Tests}}<span class="pill {{.Class}}" title="{{.Title}}">{{.Glyph}} tests {{.Text}}</span>{{end}}</div>
</div>
<div class="d-acts">{{range $i, $a := .Actions}}<form method="post" action="{{$a.URL}}" data-post><button class="ln{{if eq $i 0}} main{{end}}">{{cap $a.Label}}</button></form>{{end}}{{with .AppURL}}<a class="ln" href="{{.}}" target="_blank" rel="noopener">Open app ↗</a>{{end}}{{if .Tests}}<form method="post" action="{{.TaskURL}}" data-post><input type="hidden" name="task" value="test"><button class="ln">Run tests</button></form>{{end}}
<details class="menu" data-keep="term"><summary class="ln">Terminal ▾</summary><div class="menu-pop">{{range .AgentTerms}}<button type="button" class="hb" data-term="{{.URL}}" data-term-label="{{.Name}}" data-term-agent data-term-tab="agent" title="{{.Name}}'s terminal, on the Agent tab">Agent: {{.Name}}{{if .Running}} ●{{end}} ▣</button>{{end}}{{range .Terms}}<button type="button" class="hb" data-term="{{.URL}}" data-term-label="{{.Label}}" title="A live terminal in this page">{{.Label}} ▣</button>{{end}}<form method="post" action="{{.TermWindowURL}}" data-post><button class="hb" title="Open a terminal window on this machine's desktop">Open window ↗</button></form></div></details>
<details class="menu" data-keep="more"><summary class="ln" aria-label="More actions" title="More actions">⋯</summary><div class="menu-pop">{{if .PR}}<a class="hb" href="{{.PRPageURL}}" title="Checks, reviews, comments, merge">PR page</a>{{end}}<a class="hb danger" href="{{.DownURL}}" data-dialog="down" title="Stop it and delete its volumes">Down…</a>{{if .RemoveURL}}<a class="hb danger" href="{{.RemoveURL}}" data-dialog="remove"{{if .Merged}} title="Its PR is merged"{{end}}>{{if .Merged}}PR merged: remove…{{else}}Remove…{{end}}</a>{{end}}</div></details></div>
</div>
<nav class="tabs" aria-label="Worktree sections"><button type="button" data-tab="overview">Overview</button><button type="button" data-tab="agent">Agent</button>{{if .Tests}}<button type="button" data-tab="tests">Tests</button>{{end}}{{if .SnapshotsURL}}<button type="button" data-tab="database">Database</button>{{end}}<button type="button" data-tab="jobs">Jobs</button></nav>
<div class="dcards">
<section class="dcard wide" data-panel="services"><h2 class="lbl">Services <span class="muted">{{.ServicesUp}}</span></h2>
<div class="services">{{range .Services}}<div class="svc{{if ne .Word "running"}} attn{{end}}" data-svc="{{.Name}}" title="{{.Name}}: {{.State}}"><span class="g {{.Class}}" aria-hidden="true">{{.Glyph}}</span><span class="mono name">{{.Name}}</span><span class="st {{.Class}}">{{.Word}}</span><span class="svc-acts">{{if .LogsPost}}<form method="post" action="{{.LogsPost}}" data-post><button title="Print the journal of {{.Name}} in Jobs">Logs</button></form>{{else if .LogsURL}}<a href="{{.LogsURL}}" target="_blank" rel="noopener" title="{{.Name}}'s logs in Dozzle">Logs</a>{{end}}{{if .RestartURL}}<form method="post" action="{{.RestartURL}}" data-post{{with .Confirm}} data-confirm="{{.}}"{{end}}><button title="Restart {{.Name}} alone">Restart</button></form>{{end}}</span></div>{{else}}<span class="muted">none</span>{{end}}</div>
</section>
<section class="dcard wide" data-panel="overview"><h2 class="lbl">Links</h2>
<div class="links">{{range .Links}}<a class="{{.Class}}" href="{{.URL}}" target="_blank" rel="noopener">{{.Label}}</a>{{end}}</div>
</section>
{{if or .PR .Stacked}}<section class="dcard wide" data-panel="overview"><h2 class="lbl">Pull request{{if .PR}} <a class="quiet-link" href="{{.PRPageURL}}" title="Checks, reviews, comments, merge">PR page</a>{{end}}</h2>
{{with .PR}}<div>{{if .URL}}<a class="pr-line {{.StateClass}}" href="{{.URL}}" target="_blank" rel="noopener" title="{{.Title}}">{{.Line}}</a>{{else}}<span class="{{.StateClass}}">{{.Line}}</span>{{end}}</div>
{{end}}{{with .Stacked}}<h3 class="lbl">Stack</h3>
{{if .Error}}<div class="muted">stack ? {{.Error}}</div>
{{else}}<div class="stack-head muted">{{if .Number}}◆ {{if .NumberURL}}<a href="{{.NumberURL}}" target="_blank" rel="noopener">Stack #{{.Number}}</a>{{else}}Stack #{{.Number}}{{end}} · {{end}}Base: <span class="mono">{{.Trunk}}</span> · {{.Count}}{{if .Restack}} · <span class="yellow">⚠ restack needed</span>{{end}}</div>
<ol class="gh-stack">{{range $b := .Open}}<li class="stack-branch{{if .Current}} head{{end}}"><span class="muted">├</span> {{with .PR}}{{if $b.PRURL}}<a class="pr {{.StateClass}}" href="{{$b.PRURL}}" target="_blank" rel="noopener">#{{.Number}}</a>{{else}}<span class="{{.StateClass}}">#{{.Number}}</span>{{end}}{{if .Glyph}} <span class="{{.ChecksClass}}">{{.Glyph}}</span>{{end}} <span class="{{.StateClass}}">{{.State}}</span>{{if .Review}} · <span class="{{.ReviewClass}}">{{.Review}}</span>{{end}}{{else}}<span class="muted">no PR</span>{{end}} {{if .Current}}<strong class="mono">{{.Name}}</strong> <strong class="accent">◀ HEAD</strong>{{else if eq $.Switching .Name}}<span class="mono">{{.Name}}</span> <span class="blue switching">◐ switching…</span>{{else if and $.SwitchURL (not $.Switching)}}<form method="post" action="{{$.SwitchURL}}" class="stack-switch" data-post><input type="hidden" name="branch" value="{{.Name}}"><button class="mono" title="Check out {{.Name}} here">{{.Name}}</button></form>{{else}}<span class="mono">{{.Name}}</span>{{end}}{{if .Queued}} <span class="blue">queued</span>{{end}}{{if .NeedsRebase}} <span class="yellow" title="needs restack">⚠</span>{{end}}</li>
{{end}}{{with .Merged}}<li class="stack-merged"><details><summary><span class="muted">├</span> <span class="green">✓ {{len .}} merged</span></summary><ol>{{range $m := .}}<li class="muted">{{with .PR}}{{if $m.PRURL}}<a class="pr" href="{{$m.PRURL}}" target="_blank" rel="noopener">#{{.Number}}</a>{{else}}#{{.Number}}{{end}}{{end}} <span class="mono">{{.Name}}</span></li>{{end}}</ol></details></li>
{{end}}<li class="stack-trunk muted">└ <span class="mono">{{.Trunk}}</span></li></ol>
{{end}}{{end}}</section>
{{end}}
{{template "usage-card" .UsageCard}}<section class="dcard" data-panel="agent"><h2 class="lbl">Agent <a class="quiet-link" href="{{.AgentDefaultURL}}" data-dialog="agentdefault">Default config…</a></h2>
{{with .RunningAgent}}<div class="agent-now on"><span class="agent-dot" aria-hidden="true"></span><div class="agent-what"><b><span class="mono">{{.Name}}</span> is running</b>{{with $.Agent}}<span class="{{.Class}}">{{cap .Label}}</span>{{end}}</div><div class="agent-acts"><button type="button" class="ln main" data-term="{{.URL}}" data-term-label="{{.Name}}" data-term-agent data-term-tab="agent">Open terminal</button><form method="post" action="{{$.AgentStopURL}}" data-post data-confirm="Stop {{.Name}}? Its session ends; what it changed in the worktree stays."><input type="hidden" name="agent" value="{{.Name}}"><button class="ln danger">Stop {{.Name}}</button></form></div></div>
{{with $.Agent}}{{if .Message}}<div class="msg">{{.Message}}</div>{{end}}{{end}}
{{if gt (len $.AgentTerms) 1}}<div class="agent-others"><span class="muted">Other agents:</span>{{range $.AgentTerms}}{{if not .Running}} <span><b class="mono">{{.Name}}</b> <span class="muted">stopped</span></span> <button type="button" class="ln" data-switch-url="{{$.AgentStopURL}}" data-switch-from="{{$.RunningAgent.Name}}" data-switch-term="{{.URL}}" data-switch-to="{{.Name}}">Switch to {{.Name}}</button>{{end}}{{end}}</div>
{{end}}{{else}}<div class="agent-now"><span class="agent-dot" aria-hidden="true"></span><div class="agent-what"><b>No agent running</b><span class="muted">An agent starts in this worktree's container when its terminal opens.</span></div><div class="agent-acts">{{range $i, $a := .AgentTerms}}<button type="button" class="ln{{if eq $i 0}} main{{end}}" data-term="{{.URL}}" data-term-label="{{.Name}}" data-term-agent data-term-tab="agent">Start {{.Name}}</button>{{end}}</div></div>
{{end}}{{if .AgentSetupURL}}<div class="agent-others"><span class="muted">Setup:</span>{{range .AgentTerms}}<form method="post" action="{{$.AgentSetupURL}}" data-post data-confirm="Run {{.Name}}'s setup commands again? They run at its next start; a running {{.Name}} needs a stop and a start."><input type="hidden" name="agent" value="{{.Name}}"><button class="ln quiet">Run {{.Name}}'s setup again</button></form>{{end}}</div>
{{end}}{{template "queue-detail" .Queue}}
</section>
{{with .Tests}}<section class="dcard" data-panel="tests"><h2 class="lbl">Tests</h2>
<div><span class="{{.Class}}">{{.Glyph}} {{.Text}}</span>{{if .Stale}} <span class="stale">stale</span>{{end}} <span class="muted">{{.Title}}</span></div>
<div class="actions"><form method="post" action="{{$.TaskURL}}" data-post><input type="hidden" name="task" value="test"><button class="ln">Run tests</button></form></div>
</section>
{{end}}{{template "detail-database" .}}
</div>
{{end}}</section>{{end}}

{{/* The project's unset secrets: up refuses them. Each value goes only to
a secret set job's stdin; Start waits for the last one. */}}
{{define "secrets-needed"}}<section id="secrets-needed" class="card secrets-needed">
<h2 data-todo>Set these secrets to start {{.Base}}</h2>
<h2 data-done hidden>Ready to start {{.Base}}</h2>
<p class="note" data-todo>up refuses a secret that isn't set. Each value goes only to the job that stores it in podman's secret store.</p>
<table class="set-table">
<tbody>
{{range .Unset}}<tr class="secret"><td class="mono">{{.Name}}</td><td class="mono">{{.Services}}</td><td class="mono">{{.Delivery}}</td>
<td><form method="post" action="{{$.SecretURL}}" class="secret-form" data-secret-needed data-blocks><input type="hidden" name="name" value="{{.Name}}"><input type="password" name="value" required autocomplete="off" placeholder="value" aria-label="Value of {{.Name}}"><button class="ln">Set value</button></form></td></tr>
{{end}}{{range .Later}}<tr class="secret"><td class="mono">{{.Name}}</td><td class="mono">{{.Services}} <span class="muted">(when it runs; not needed to start)</span></td><td class="mono">{{.Delivery}}</td>
<td><form method="post" action="{{$.SecretURL}}" class="secret-form" data-secret-needed><input type="hidden" name="name" value="{{.Name}}"><input type="password" name="value" required autocomplete="off" placeholder="value" aria-label="Value of {{.Name}}"><button class="ln">Set value</button></form></td></tr>
{{end}}</tbody>
</table>
{{if .StartURL}}<form method="post" action="{{.StartURL}}" data-start-base data-base="{{.Base}}"><button class="ln main" disabled>Start {{.Base}}</button></form>
<p class="note" data-starting hidden>Starting {{.Base}}: its output is in {{.Base}}'s jobs.</p>{{end}}
</section>{{end}}

{{/* The worktree's agent usage, at the top of its Agent tab (D187): a
table, the daily bars (new tokens below, output above) on a round axis
with the usual day dashed, and two meters. SVG attributes and classes
only. */}}
{{define "usage-card"}}{{with .}}<section class="dcard wide usage-card" data-panel="agent"><div class="usage-hd"><h2 class="lbl">Usage · this worktree</h2>{{template "usage-range" .Ranges}}</div>
{{if .Empty}}<p class="muted usage-note">{{.Empty}}</p>
{{else}}<table class="usage-table"><thead><tr><th scope="col"></th><th scope="col"><span class="swatch u-new" aria-hidden="true"></span> New</th><th scope="col"><span class="swatch u-out" aria-hidden="true"></span> Output</th><th scope="col">Cache reads</th><th scope="col">Cost</th></tr></thead>
<tbody>{{range $i, $r := .Table}}<tr{{if and (eq $i 0) $.Runaway}} class="yellow" title="Over 3 times its usual day"{{end}}><th scope="row">{{if and (eq $i 0) $.Runaway}}⚠ {{end}}{{.Label}}</th><td>{{.New}}</td><td>{{.Output}}</td><td class="muted">{{.CacheRead}}</td><td class="muted">{{.Cost}}</td></tr>{{end}}</tbody></table>
<div class="usage-plot"><div class="usage-y" aria-hidden="true"><span>{{.YTop}}</span><span>{{.YMid}}</span><span>0</span></div><div class="usage-main">
<svg class="usage-bars" viewBox="0 0 {{.W}} {{.H}}" preserveAspectRatio="none" role="img" aria-label="New tokens and output per day for {{.Days}} days{{if .Usual}}, against the worktree's usual day{{end}}"><line class="grid" x1="0" x2="{{.W}}" y1="{{.GridY}}" y2="{{.GridY}}"/>{{range .Bars}}<rect class="{{.Class}}" x="{{.X}}" y="{{.Y}}" width="{{.W}}" height="{{.H}}"><title>{{.Title}}</title></rect>{{end}}{{with .Usual}}<line class="usual" x1="0" x2="{{$.W}}" y1="{{.Y}}" y2="{{.Y}}"><title>{{.Title}}</title></line>{{end}}</svg>
<div class="usage-days" aria-hidden="true">{{range .Days3}}<span>{{.}}</span>{{end}}</div></div></div>
{{with .Note}}<p class="muted usage-note">{{.}}</p>{{end}}
{{end}}<div class="usage-meters">{{with .Context}}{{template "meter" .}}{{else}}<div class="meter"><span class="muted">This session's context</span><span class="muted">No session running</span></div>{{end}}{{with .Share}}{{template "meter" .}}{{end}}</div>
</section>{{end}}{{end}}

{{define "meter"}}<div class="meter"><span class="muted">{{.Label}}</span><svg class="meter-bar" viewBox="0 0 100 8" preserveAspectRatio="none" role="img" aria-label="{{.Aria}}"><rect class="track" width="100" height="8"/><rect class="fill" width="{{.Fill}}" height="8"/></svg><span><b>{{.Value}}</b> {{.Of}}</span></div>{{end}}
