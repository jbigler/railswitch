{{define "newwt"}}<dialog id="newwt" class="dlg">
<form method="post" action="{{.AddURL}}" data-post data-close>
<h2>New worktree</h2>
<label>Branch <input name="branch" required autocomplete="off" class="mono"></label>
<label>Name <input name="name" placeholder="from the branch" autocomplete="off" class="mono"></label>
<label class="check"><input type="checkbox" name="up" checked> up after adding</label>
<div class="btns"><button type="button" class="ln" data-cancel>Cancel</button><button class="ln main">Add</button></div>
</form>
</dialog>{{end}}

{{define "remove"}}<form method="post" action="{{.URL}}" class="remove" data-post data-close data-slug="{{.Slug}}">
<h2>Remove {{.Slug}}?</h2>
<p>This removes:</p>
<ul>
<li>the checkout <code>{{.Dir}}</code></li>
<li>its containers and volumes</li>
<li>its nvim and agent homes</li>
{{if .Board}}<li>its whiteboard drawing (download it from the Whiteboard tab to keep it)</li>
{{end}}</ul>
{{if .Dirty}}<p class="red">{{.Slug}} has uncommitted changes or untracked files. Removing it loses them.</p>
<label class="check"><input type="checkbox" name="force" value="1" required> Discard changes</label>
<label>Type <b>{{.Slug}}</b> to confirm <input name="confirm" required autocomplete="off" class="mono"></label>
{{end}}<div class="btns"><button type="button" class="ln" data-cancel>Cancel</button><button class="ln danger">Remove</button></div>
</form>{{end}}

{{define "down"}}<form method="post" action="{{.URL}}" class="remove" data-post data-close>
<h2>Take {{.Slug}} down?</h2>
<p>This stops it and deletes:</p>
<ul>
<li>its containers</li>
<li>its volumes: its database, cache and storage data</li>
</ul>
<p>The checkout, its branch and the project's shared volumes stay. The next start begins with empty data, seeded from <code>db-dumps/</code> when there is a dump, and runs the create hooks again.</p>
{{with .SnapshotsURL}}<p>To keep the database, take a <a href="{{.}}" data-dialog="snapshots">snapshot</a> first.</p>
{{end}}<div class="btns"><button type="button" class="ln" data-cancel>Cancel</button><button class="ln danger">Delete volumes</button></div>
</form>{{end}}

{{/* An agent's project default config (D135): promote this worktree's,
or have homes take the default at their agent's next start. */}}
{{define "agentdefault"}}<div class="agentdefault">
<h2>Agent config in {{.Slug}}</h2>
{{range .Agents}}<section class="agent-default">
<h3>{{.Name}}</h3>
{{if .Default}}<p>Default: from <b>{{.Default.From}}</b>, {{.Promoted}}.</p>
{{if .Pending}}<p class="yellow">Pending: {{$.Slug}}'s {{.Name}} takes the default at its next start{{if .Running}} (it runs now: stop it, then start it again){{end}}.</p>{{end}}{{else}}<p class="muted">No default yet: a new worktree's {{.Name}} starts with an empty config.</p>{{end}}
<form method="post" action="{{$.PromoteURL}}" data-post data-close class="ad-row"><input type="hidden" name="name" value="{{.Name}}">
<span>Save {{$.Slug}}'s config as the default</span><button class="ln main">Save as default</button></form>
{{if .Default}}<form method="post" action="{{$.ApplyURL}}" data-post data-close class="ad-row"><input type="hidden" name="name" value="{{.Name}}">
<span>Replace a worktree's config with the default</span><span><button class="ln">This worktree</button><button class="ln" name="all" value="1">Every worktree</button></span></form>{{end}}
</section>
{{else}}<p class="muted">No agent of this project has a config to share: its package lists no <code>[config] paths</code>.</p>
{{end}}<p class="note">An agent takes the default the next time it starts (stop a running one first); what it replaces is kept in <code>~/.railswitch-default-backup</code>. A new worktree starts from the default.</p>
<div class="btns"><button type="button" class="ln" data-cancel>Close</button></div>
</div>{{end}}
