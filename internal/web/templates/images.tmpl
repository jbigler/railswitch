{{define "images"}}<!doctype html>
<html lang="en">
{{template "head" .}}
<body data-prefix="{{.Prefix}}" data-view="images">
{{template "top" .}}
<main class="grid settings">
<section class="left set-left">
<div class="crumb"><a href="/p/{{.Prefix}}">← {{.Prefix}}</a></div>
<h1>Images</h1>
<form class="sopt wt-pick" method="get"><label class="sopt-key" for="wt-pick">Worktree</label><select id="wt-pick" name="wt" class="mono" data-submit>{{range .Worktrees}}<option value="{{.Slug}}"{{if .Current}} selected{{end}}>{{.Slug}}</option>{{end}}</select></form>
<p class="note">What this worktree builds, in order. Every RUN line runs on this machine during the build, outside the firewall.</p>
{{if .Error}}<p class="red set-error">{{.Error}}</p>
{{end}}{{if .Warnings}}<div class="warnings">{{range .Warnings}}<p class="yellow">{{.}}</p>
{{end}}</div>
{{end}}<section class="spanel">
<table class="set-table chain">
<thead><tr><th>Step</th><th>Kind</th><th>File</th><th>From</th><th>Tag</th><th></th></tr></thead>
<tbody>
{{range .Steps}}<tr><td>{{.Name}}</td><td class="muted">{{.Kind}}</td><td class="mono file">{{.File}}{{if .DefaultChanged}} <a class="chip yellow" href="{{.EditURL}}" title="The default this file was ejected from changed since. Compare or reset in the editor.">Default changed</a>{{end}}</td><td class="mono tag-cell">{{.From}}</td><td class="mono tag-cell">{{.Tag}}</td><td class="act">{{if .EditURL}}<a class="ln" href="{{.EditURL}}">Edit</a>{{end}}</td></tr>
{{else}}<tr><td colspan="6" class="muted">No images.</td></tr>
{{end}}</tbody>
</table>
<h3>New addon</h3>
<p class="note">Writes <code>containerfiles/Containerfile.&lt;name&gt;</code>, adds it to <code>[image] addons</code> and opens the editor on it.</p>
<form method="post" action="{{.NewURL}}" class="add-row" data-job="new-addon" data-next="/p/{{.Prefix}}/images/edit/">
<input name="name" placeholder="name" class="mono" autocomplete="off" required pattern="[a-z][a-z0-9\-]{0,30}" aria-label="Addon name">
<button class="ln">Create</button>
</form>
</section>
</section>
<section class="pane">
{{template "jobs" .Jobs}}
</section>
</main>
{{template "common-dialogs" .}}
</body>
</html>
{{end}}
