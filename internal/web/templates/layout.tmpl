{{/* The parts every page shares; each takes a view with Title, Header,
Strip, Banner and Projects. */}}
{{define "head"}}<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<link rel="stylesheet" href="/static/app.css">
<link rel="stylesheet" href="/theme.css" id="theme">
<script src="/static/app.js" type="module"></script>
<script src="/static/stats.js" defer></script>
</head>{{end}}

{{define "top"}}{{template "header" .Header}}
{{template "strip" .Strip}}
{{template "banner" .Banner}}
<div id="conn" class="banner conn" hidden></div>
<div id="toast" class="toast" popover="manual"></div>{{end}}

{{define "common-dialogs"}}<dialog id="switcher" class="dlg">
<h2>Projects</h2>
<input id="switcher-filter" type="search" placeholder="Filter projects and worktrees" autocomplete="off">
{{template "projects" .Projects}}
<p class="note">1–9 jump · Esc closes</p>
</dialog>
<dialog id="palette" class="dlg"></dialog>
<dialog id="colors" class="dlg"></dialog>
<dialog id="ttys" class="dlg"></dialog>{{end}}

{{define "ttys"}}<h2>Terminals <span class="muted">{{.Running}} of {{.Max}} running</span></h2>
<p class="note">A terminal runs until it is ended here, its panel is closed (✕) or its program exits. Leaving a page doesn't end it.</p>
<table class="set-table">
<thead><tr><th>Project</th><th>Worktree</th><th>Terminal</th><th></th></tr></thead>
<tbody>
{{range .Items}}<tr><td class="mono">{{.Prefix}}</td><td class="mono"><a href="{{.URL}}">{{.Slug}}</a></td><td>{{.Text}}{{if .Ended}} <span class="muted">exited {{.Exit}}: its worktree page shows the end</span>{{end}}</td><td>{{if not .Ended}}<form method="post" action="/ttys/{{.ID}}/end" data-post data-close><button class="ln danger" title="End this terminal's program">End</button></form>{{end}}</td></tr>
{{else}}<tr><td colspan="4" class="muted">No terminal is running.</td></tr>
{{end}}</tbody>
</table>
<p><button type="button" class="ln" data-cancel>Close</button></p>{{end}}

{{define "page"}}<!doctype html>
<html lang="en">
{{template "head" .}}
<body data-prefix="{{.Prefix}}" data-sel="{{.Sel}}" data-sort="{{.Sort}}" data-days="{{.Days}}" data-pane="{{.Pane}}">
{{template "top" .}}
<main class="grid wt">
<section class="left">
<div class="filter"><input id="wt-filter" type="search" placeholder="Filter worktrees" aria-label="Filter worktrees" autocomplete="off"><form method="post" action="{{.List.RefreshURL}}" data-post><button class="ln dim" title="Refresh PRs" aria-label="Refresh PRs">↻</button></form><button type="button" class="ln main" data-open="newwt">+ New</button></div>
{{template "list" .List}}
{{template "usage" .Usage}}
<div class="note">↑↓ moves through worktrees · P switches project · : command palette</div>
</section>
<section class="pane">
<a class="back" href="{{.ListURL}}">← worktrees</a>
{{with .Secrets}}{{template "secrets-needed" .}}{{end}}
{{template "detail" .Detail}}
{{template "jobs" .Jobs}}
<div id="terms" class="terms"></div>
<p id="terms-none" class="muted">No terminal is open in this worktree. <b>Terminal ▾</b> opens a shell or nvim here; the <kbd>:</kbd> palette runs a task in one. A terminal keeps running when you leave the page, until you close it.</p>
</section>
</main>
{{template "common-dialogs" .}}
{{template "newwt" .List}}
<dialog id="remove" class="dlg"></dialog>
<dialog id="down" class="dlg"></dialog>
<dialog id="agentdefault" class="dlg"></dialog>
<dialog id="snapshots" class="dlg"></dialog>
<dialog id="agentqueue" class="dlg"></dialog>
</body>
</html>
{{end}}

{{/* tabs is a page's tab bar (Settings, Library, the worktree): a tabsView. */}}
{{define "tabs"}}<nav class="tabs{{if .Stab}} stabs{{end}}" aria-label="{{.Label}}">{{range .Tabs}}<button type="button" {{if $.Stab}}data-stab{{else}}data-tab{{end}}="{{.Key}}">{{.Label}}{{with .BadgeID}} <span class="badge" id="{{.}}" hidden></span>{{end}}</button>{{end}}</nav>{{end}}
