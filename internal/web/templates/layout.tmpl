{{/* The parts every page shares; each takes a view with Title, Header,
Strip, Banner and Projects. */}}
{{define "head"}}<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<link rel="stylesheet" href="/static/app.css">
<link rel="stylesheet" href="/theme.css" id="theme">
<script src="/static/app.js" defer></script>
<script src="/static/stats.js" defer></script>
</head>{{end}}

{{define "top"}}{{template "header" .Header}}
{{template "strip" .Strip}}
{{template "banner" .Banner}}
<div id="conn" class="banner conn" hidden></div>
<div id="toast" class="toast" popover="manual"></div>{{end}}

{{define "common-dialogs"}}<dialog id="switcher" class="dlg">
<h2>Projects</h2>
<input id="switcher-filter" type="search" placeholder="Filter projects and worktrees" autocomplete="off">
{{template "projects" .Projects}}
<p class="note">1–9 jump · Esc closes</p>
</dialog>
<dialog id="palette" class="dlg"></dialog>
<dialog id="colors" class="dlg"></dialog>{{end}}

{{define "page"}}<!doctype html>
<html lang="en">
{{template "head" .}}
<body data-prefix="{{.Prefix}}" data-sel="{{.Sel}}" data-sort="{{.Sort}}" data-pane="{{.Pane}}">
{{template "top" .}}
<main class="grid wt">
<section class="left">
<div class="filter"><input id="wt-filter" type="search" placeholder="Filter worktrees" aria-label="Filter worktrees" autocomplete="off"><form method="post" action="{{.List.RefreshURL}}" data-post><button class="ln dim" title="Refresh PRs" aria-label="Refresh PRs">↻</button></form><button type="button" class="ln main" data-open="newwt">+ New</button></div>
{{template "list" .List}}
{{template "usage" .Usage}}
<div class="note">↑↓ moves through worktrees · P switches project · : command palette</div>
</section>
<section class="pane">
<a class="back" href="{{.ListURL}}">← worktrees</a>
{{with .Secrets}}{{template "secrets-needed" .}}{{end}}
{{template "detail" .Detail}}
{{template "jobs" .Jobs}}
<div id="terms" class="terms"></div>
</section>
</main>
{{template "common-dialogs" .}}
{{template "newwt" .List}}
<dialog id="remove" class="dlg"></dialog>
<dialog id="down" class="dlg"></dialog>
<dialog id="agentdefault" class="dlg"></dialog>
<dialog id="snapshots" class="dlg"></dialog>
<dialog id="agentqueue" class="dlg"></dialog>
</body>
</html>
{{end}}
