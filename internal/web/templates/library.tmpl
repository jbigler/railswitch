{{define "library"}}<!doctype html>
<html lang="en">
{{template "head" .}}
<body data-prefix="{{.Prefix}}" data-view="library">
{{template "top" .}}
<main class="grid settings">
<section class="left set-left">
<div class="crumb"><a href="/p/{{.Prefix}}">← {{.Prefix}}</a></div>
<h1>Library</h1>
<p class="note">The built-in packages, this workspace's own (<code>local:</code>) and those of this machine's libraries (<code>&lt;alias&gt;:</code>). Built-in and library packages are read-only; start a local copy of a built-in with New pack or New option.</p>
{{if .Error}}<p class="red set-error">{{.Error}}</p>
{{end}}{{template "libraries" .}}{{range .Groups}}<section class="card">
<h2>{{.Title}}</h2>
<ul class="lib-list">
{{range .Items}}<li{{if .Current}} class="cur"{{end}} data-ref="{{.Ref}}"><a href="{{.URL}}"><span class="mono">{{.Ref}}</span>{{if .Note}} <span class="muted">{{.Note}}</span>{{end}}<span class="sp"></span>{{if .Used}}<span class="chip green">used by this project</span>{{end}}<span class="chip">{{template "lib-source" .}}</span></a></li>
{{else}}<li class="muted">None.</li>
{{end}}</ul>
</section>
{{end}}{{template "lib-templates" .}}{{if not .Error}}<section class="card">
<h2>New pack</h2>
<form method="post" action="{{.NewURL}}" class="add-row" data-job="new-package" data-next="{{.EditorBase}}">
<input type="hidden" name="kind" value="pack">
<input name="name" placeholder="name" class="mono" autocomplete="off" required pattern="[a-z][a-z0-9\-]*" aria-label="Pack name">
<select name="from" aria-label="Start from"><option value="">blank</option>{{range .CopyPacks}}<option value="{{.}}">{{.}}</option>{{end}}</select>
<button class="ln">Create</button>
</form>
</section>
<section class="card">
<h2>New option</h2>
<form method="post" action="{{.NewURL}}" class="add-row" data-job="new-package" data-next="{{.EditorBase}}">
<input type="hidden" name="kind" value="option">
<input name="name" placeholder="name" class="mono" autocomplete="off" required pattern="[a-z][a-z0-9\-]*" aria-label="Option name">
<select name="from" aria-label="Start from"><option value="">blank</option>{{range .CopyOptions}}<option value="{{.}}">{{.}}</option>{{end}}</select>
<select name="slot" aria-label="Slot">{{range .Slots}}<option value="{{.}}">{{.}}</option>{{end}}</select>
<button class="ln">Create</button>
</form>
<p class="note">A copy keeps the built-in's slot; a blank option takes the slot picked here. The manifest opens in the editor.</p>
</section>
{{end}}</section>
<section class="pane">
{{with .Sel}}<section class="card">
<h2><span class="mono">{{.Ref}}</span> <span class="chip">{{if .Local}}local{{else if .Library}}library {{.Library.Alias}}{{else}}built in{{end}}</span></h2>
{{with .Library}}<p class="note lib-from">From the library <span class="mono">{{.Alias}}</span>{{if .ID}} (<span class="mono">{{.ID}}</span>){{end}}{{if .Status}} · last fetch <span class="chip {{.StatusClass}}">{{.Status}}</span>{{end}}. Read-only: a project installs it only through the Install review in Settings or New project.</p>
{{end}}{{if .Error}}<p class="red set-error">{{.Error}}</p>
{{end}}{{with .Doc}}{{if .Kind}}<dl class="kv">
<dt>Kind</dt><dd>{{.Kind}}</dd>
{{if .Path}}<dt>Path</dt><dd class="mono">{{.Path}}</dd>
{{end}}{{with .App}}<dt>App</dt><dd><span class="mono">{{.Service}}</span> · <span class="mono">{{.Server}}</span> on port {{.Port}}</dd>
<dt>Health</dt><dd class="mono">{{.Health}}</dd>
{{end}}{{if .Slot}}<dt>Slot</dt><dd>{{.Slot}} · service <span class="mono">{{.Service}}</span></dd>
{{end}}{{range .Runtimes}}<dt>Runtime</dt><dd><span class="mono">{{.Name}}</span> from <span class="mono">{{range $i, $f := .From}}{{if $i}}, {{end}}{{$f}}{{end}}</span>{{if .Fallback}} · fallback {{.Fallback}}{{end}}</dd>
{{end}}{{range .Ports}}<dt>Port</dt><dd><span class="mono">{{.Name}}</span> {{.Base}} + worktree ID{{if .Container}} → {{.Container}}{{end}}</dd>
{{end}}{{with .Pin}}<dt>Pin</dt><dd><span class="mono">{{.Name}}</span> default {{.Default}}</dd>
{{end}}{{if .Gives}}<dt>Gives</dt><dd class="mono">{{range $i, $g := .Gives}}{{if $i}}, {{end}}{{$g}}{{end}}</dd>
{{end}}</dl>
{{if .Readme}}<div class="lbl">README</div><pre class="out readme">{{.Readme}}</pre>
{{end}}{{end}}{{end}}<div class="lbl">Files</div>
<table class="set-table">
<tbody>
{{range .Files}}<tr><td class="mono">{{.Path}}</td><td class="muted">{{if .Size}}{{.Size}} B{{end}}{{if .Executable}} · executable{{end}}</td><td><a class="ln" href="{{.URL}}">{{if $.Sel.Local}}Edit{{else}}View{{end}}</a></td></tr>
{{end}}</tbody>
</table>
{{if .AddBase}}<form class="add-row" data-add-file data-base="{{.AddBase}}">
<input name="path" placeholder="entrypoints/name.sh" class="mono" autocomplete="off" required aria-label="New file path">
<button class="ln">Add file</button>
</form>
<p class="note">At the top: <code>Containerfile.&lt;name&gt;</code>, <code>deps.allow</code>, <code>README.md</code>, <code>&lt;name&gt;.sh</code>; or <code>entrypoints/&lt;file&gt;</code>, <code>initdb/&lt;file&gt;</code>.</p>
{{end}}</section>
{{end}}{{with .TemplateSel}}{{template "lib-template" .}}{{end}}{{template "jobs" .Jobs}}
</section>
</main>
{{template "common-dialogs" .}}
</body>
</html>
{{end}}

{{/* lib-templates is the Templates section: `template ls`, this
machine's templates and the libraries'. */}}
{{define "lib-templates"}}<section class="card" id="templates">
<h2>Templates</h2>
<p class="note">A template is a pack, its options and your overrides, ready to start a project from (New project). Save a project as one in its Settings.</p>
{{if .TemplatesError}}<p class="red set-error">Templates unavailable: {{.TemplatesError}}</p>
{{end}}<ul class="lib-list">
{{range .Templates}}<li{{if .Current}} class="cur"{{end}} data-template="{{.Ref}}"><a href="{{.URL}}"><span class="mono">{{.Ref}}</span>{{if .Description}} <span class="muted">{{.Description}}</span>{{end}}<span class="sp"></span><span class="chip">{{.Source}}</span></a></li>
{{else}}{{if not .TemplatesError}}<li class="muted">None.</li>
{{end}}{{end}}</ul>
</section>
{{end}}

{{/* lib-template is one template's `template show`: its lines,
questions and files. */}}
{{define "lib-template"}}<section class="card" id="template-detail">
<h2><span class="mono">{{.Row.Ref}}</span> <span class="chip">{{.Row.Source}}</span></h2>
{{if .Row.Description}}<p>{{.Row.Description}}</p>
{{end}}{{if .Error}}<p class="red set-error">{{.Error}}</p>
{{else}}{{with .Doc}}<dl class="kv">
<dt>Name</dt><dd class="mono">{{$.Row.Name}} · version {{$.Row.Version}}</dd>
<dt>Packages</dt><dd class="mono">{{range $i, $p := $.Row.Packages}}{{if $i}}, {{end}}{{$p}}{{else}}<span class="muted">none</span>{{end}}</dd>
<dt>Content</dt><dd class="mono">{{.SHA256}}</dd>
<dt>Secrets</dt><dd class="mono">{{range $i, $s := .Secrets}}{{if $i}}, {{end}}{{$s}}{{else}}<span class="muted">none</span>{{end}}</dd>
<dt>Containerfiles</dt><dd class="mono">{{range $i, $c := .Containerfiles}}{{if $i}}, {{end}}{{$c}}{{else}}<span class="muted">none: the packages' defaults</span>{{end}}</dd>
</dl>
<div class="lbl">Questions</div>
<table class="set-table">
<thead><tr><th>Asks</th><th>Sets</th><th>Default</th></tr></thead>
<tbody>
{{range .Ask}}<tr class="ask"><td>{{.Prompt}}</td><td class="mono">{{.Key}}</td><td class="mono">{{.Default}}</td></tr>
{{else}}<tr><td colspan="3" class="muted">No questions: a project gets the template's lines as they are.</td></tr>
{{end}}</tbody>
</table>
<div class="lbl">stack.toml</div>
<pre class="out mono toml-view">{{.StackTOML}}</pre>
{{if .Readme}}<div class="lbl">README</div><pre class="out readme">{{.Readme}}</pre>
{{end}}{{end}}{{end}}</section>
{{end}}

{{define "lib-source"}}{{if .Local}}local{{else if .Library}}library {{.Library}}{{else}}built in{{end}}{{end}}

{{/* libraries is the Libraries section: the machine's package libraries,
Fetch, Trust this key or Confirm rotation for a fetch that waits on its
signer, and Add library. */}}
{{define "libraries"}}<section class="card" id="libraries">
<h2>Libraries</h2>
<p class="note">Signed package libraries on this machine, for every project. A library's packages can be installed once its signer is trusted, and only after their Install review.</p>
{{if .LibrariesError}}<p class="red set-error">Libraries unavailable: {{.LibrariesError}}</p>
{{end}}{{range .Libraries}}{{$alias := .Alias}}<div class="lib-repo" data-alias="{{.Alias}}">
<h3><span class="mono">{{.Alias}}</span> {{if .Status}}<span class="chip {{.StatusClass}}">{{.Status}}</span>{{else}}<span class="chip">not fetched</span>{{end}}</h3>
<dl class="kv">
<dt>Repository</dt><dd class="mono">{{.URL}}{{if .Branch}} · {{.Branch}}{{end}}</dd>
{{if .ID}}<dt>Library</dt><dd class="mono">{{.ID}}</dd>
{{end}}<dt>Fetched</dt><dd>{{if .Fetched}}{{.Fetched}} · serial {{.Serial}}{{if .Commit}} · <span class="mono">{{.Commit}}</span>{{end}} · {{.Packages}} {{if eq .Packages 1}}package{{else}}packages{{end}}{{else}}never{{end}}</dd>
</dl>
{{with .Pending}}<div class="lib-trust{{if .Known}} danger{{end}}">
{{if .Rotation}}<b>Confirm rotation</b>
<p>The last fetch is signed by a new key, and the key this machine trusts for the library vouches for it.</p>
<span class="muted">Trusted key</span> <span class="mono fp">{{.Trusted}}</span>
<span class="muted">New key</span> <span class="mono fp">{{.Fingerprint}}</span>
<p class="note">Check the new key's fingerprint with the publisher, through a channel other than the library, before you confirm.</p>
{{else}}<b>Trust this key</b>
<p>The last fetch is signed by a key this machine doesn't trust yet:</p>
<span class="mono fp">{{.Fingerprint}}</span>
<p class="note">Check this fingerprint with the publisher, through a channel other than the library, before you trust it.</p>
{{if .Known}}<p class="red">This library already trusts other keys, and none of them vouched for this one. It may be an attacker's key. Trust it only if the publisher confirms a new signer through another channel.</p>
{{end}}{{end}}<form method="post" action="{{$.LibTrustURL}}" data-job="library-trust" data-confirm="{{if .Rotation}}Confirm the rotation of {{$alias}} to {{.Fingerprint}}?{{else}}Trust {{.Fingerprint}} to sign {{$alias}}?{{end}} Packages it signs can then be installed.">
<input type="hidden" name="alias" value="{{$alias}}">
<input type="hidden" name="fingerprint" value="{{.Fingerprint}}">
<input type="hidden" name="kind" value="{{if .Rotation}}rotation{{else}}trust{{end}}">
{{if .Known}}<label class="check"><input type="checkbox" name="new_signer" value="1" required> The publisher confirmed this new signer through another channel</label>
{{end}}<div class="btns start"><button class="ln main">{{if .Rotation}}Confirm rotation{{else}}Trust this key{{end}}</button></div>
</form>
</div>
{{end}}<form method="post" action="{{$.LibFetchURL}}" class="btns start" data-job="library-fetch">
<input type="hidden" name="alias" value="{{.Alias}}">
<button class="ln">Fetch</button>
</form>
</div>
{{else}}{{if not .LibrariesError}}<p class="muted">No libraries.</p>
{{end}}{{end}}<div class="lbl">Add library</div>
<form method="post" action="{{.LibAddURL}}" class="add-row" data-job="library-add">
<input name="url" placeholder="https://github.com/owner/library" class="mono" autocomplete="off" spellcheck="false" required aria-label="Library URL">
<input name="alias" placeholder="alias" class="mono" autocomplete="off" spellcheck="false" required maxlength="20" pattern="[a-z][a-z0-9\-]{0,19}" aria-label="Alias">
<input name="branch" placeholder="branch" class="mono" autocomplete="off" spellcheck="false" aria-label="Branch (empty: the default)">
<button class="ln">Add library</button>
</form>
<p class="note">The alias prefixes its packages' refs (<code>&lt;alias&gt;:django@1</code>). Adding fetches it; a signer not trusted yet waits here for Trust this key.</p>
</section>
{{end}}
