{{define "list"}}<div id="list" class="list">
<div class="tb">Sort <span class="seg">{{range .Sorts}}<a{{if .On}} class="on"{{end}} href="{{.URL}}" data-sort>{{.Label}}{{if .On}}{{if .Rev}} ↑{{else}} ↓{{end}}{{end}}</a>{{end}}</span><span class="sp"></span><form method="post" action="{{.RefreshURL}}" data-post><button class="ln dim">Refresh PRs</button></form><button type="button" class="ln dim" data-open="newwt">+ New worktree</button></div>
<table>
<thead><tr><th>worktree</th><th>branch</th><th>PR</th><th>stack</th><th>agent</th></tr></thead>
<tbody>
{{range .Rows}}{{template "row" .}}
{{end}}</tbody>
</table>
{{if not .Rows}}<p class="note">No worktrees.</p>{{end}}
</div>{{end}}

{{define "row"}}<tr id="{{.ID}}"{{if .Sel}} class="sel"{{end}} data-slug="{{.Slug}}">
<td>{{if .Need}}<span class="need" title="{{.AgentTitle}}" aria-label="{{.Need}}">◆</span> {{end}}<a href="{{.URL}}" data-row>{{.Slug}}</a>{{if .Base}} <span class="muted">(base)</span>{{end}}</td>
<td class="br mono"><span class="trunc" title="{{.Branch}}">{{.Branch}}</span>{{with .Stacked}} <span class="stacked" title="position in its gh stack">≡ {{.}}</span>{{end}}</td>
<td{{with .PR}} title="{{.Title}}"{{end}}>{{with .PR}}<a class="pr" href="{{.URL}}" target="_blank" rel="noopener">#{{.Number}}</a>{{if .Glyph}} <span class="{{.ChecksClass}}">{{.Glyph}}</span>{{end}} <span class="{{.StateClass}}">{{.State}}</span>{{if .Review}} · <span class="{{.ReviewClass}}">{{.Review}}</span>{{end}}{{else}}<span class="muted">—</span>{{end}}</td>
<td class="{{.StackClass}}">{{.StackGlyph}} {{.StackText}}{{if .Stale}} <span class="stale">restart to apply</span>{{end}}</td>
<td class="{{.AgentClass}}"{{if .AgentTitle}} title="{{.AgentTitle}}"{{end}}>{{.AgentGlyph}} {{.AgentText}}</td>
</tr>{{end}}
