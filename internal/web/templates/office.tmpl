{{/* office: the Virtual Office view (D146, D153), a 3D page drawn by static/office/. */}}
{{define "office"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<link rel="stylesheet" href="/static/office/office.css">
<script type="module" src="/static/office/office.js"></script>
</head>
<body data-prefix="{{.Prefix}}" data-set="{{.Set}}">
<div id="scene" aria-hidden="true"></div>
<header class="hud-top">
  <a class="hud-btn" href="/p/{{.Prefix}}">◂ dashboard</a>
  <span class="hud-where" id="where">Arriving…</span>
  <button class="hud-btn" type="button" id="view">walk</button>
  <button class="hud-btn" type="button" id="invert" aria-pressed="false" title="Invert the mouse's up and down">invert Y</button>
  <button class="hud-btn" type="button" id="transport">elevator <kbd>T</kbd></button>
</header>
<div class="hud-tip" id="tip" hidden></div>
<p class="hud-help" id="help" hidden><kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd> or arrows walk · <kbd>Shift</kbd> runs · drag looks · click acts, or walks there · <kbd>V</kbd> overview</p>
<ul class="hud-jobs" id="jobs" aria-live="polite"></ul>
<p class="hud-banner" id="banner" hidden></p>
<aside class="panel" id="panel" hidden>
  <header><h2 id="panel-title"></h2><button type="button" class="hud-btn" id="panel-close" aria-label="Close">✕</button></header>
  <div id="panel-body"></div>
</aside>
<noscript><p class="hud-banner">The Virtual Office needs JavaScript and WebGL. <a href="/p/{{.Prefix}}">Back to the dashboard</a>.</p></noscript>
</body>
</html>
{{end}}
