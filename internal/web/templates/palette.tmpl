{{define "tasks"}}<form method="post" action="{{.URL}}" class="palette" data-post data-close>
<h2>{{if .Slug}}Commands in {{.Slug}}{{else}}Commands{{end}}</h2>
<input type="search" class="pal-filter" placeholder="Filter tasks, actions, worktrees and pages" autocomplete="off" autofocus>
{{if .Slug}}<label>args <input name="args" class="pal-args mono" autocomplete="off" placeholder="quotes and \ as in a shell"></label>
<label class="check"><input type="checkbox" name="term" value="1" class="pal-term" checked> in a new terminal <span class="muted">(off: a job, its output under Jobs)</span></label>
{{end}}<ul class="pal-list">
{{range .Tasks}}<li data-filter="task {{.Name}}">{{if .Terminal}}<button type="button" class="pal-task" data-term="{{$.TTY}}task?task={{urlquery .Name}}" data-term-label="{{.Name}}" title="Opens in a terminal panel"><span class="pal-kind">task</span> <b>{{.Name}}</b> ▣ <span class="mono muted">{{.Command}}</span> <span class="muted">{{.Source}}</span></button>{{else}}<button name="task" value="{{.Name}}" class="pal-task"><span class="pal-kind">task</span> <b>{{.Name}}</b> <span class="mono muted">{{.Command}}</span> <span class="muted">{{.Source}}</span></button>{{end}}</li>
{{else}}{{if .Slug}}<li class="muted pal-none">No tasks.</li>
{{end}}{{end}}{{range .Actions}}<li data-filter="action {{.Label}}"><button formaction="{{.URL}}" class="pal-task" data-action><span class="pal-kind">action</span> <b>{{.Label}}</b> <span class="muted">{{$.Slug}}</span></button></li>
{{end}}{{range .Worktrees}}<li data-filter="worktree {{.Label}}"><a href="{{.URL}}" class="pal-task"><span class="pal-kind">worktree</span> <b>{{.Label}}</b></a></li>
{{end}}{{range .Pages}}<li data-filter="page {{.Label}}"><a href="{{.URL}}" class="pal-task"><span class="pal-kind">page</span> <b>{{.Label}}</b></a></li>
{{end}}{{if .Slug}}<li class="pal-new" hidden><a class="pal-task" href="{{.SettingsURL}}#tasks" data-base="{{.SettingsURL}}">New task <b class="mono"></b>…</a></li>
{{end}}</ul>
<p class="note">Enter runs the highlighted line{{if .Slug}}: a task as the box says, Shift+Enter the other way; a task marked ▣ opens in a terminal panel, without args{{end}} · Esc closes</p>
</form>{{end}}
