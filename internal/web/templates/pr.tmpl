{{/* A worktree's pull request (D152): GitHub's data from pr show --json,
its merge, ready and rerun actions as jobs. Every text from GitHub is
escaped here; data-md bodies get their Markdown as text nodes (app.js). */}}
{{define "pr"}}<!doctype html>
<html lang="en">
{{template "head" .}}
<body data-prefix="{{.Prefix}}" data-view="pr">
{{template "top" .}}
<main class="grid settings">
<section class="left set-left prpage">
<div class="crumb"><a href="{{.Back}}">← {{.Slug}}</a></div>
{{if .Error}}<h1>Pull request</h1>
<p class="red set-error">{{.Error}}</p>
{{else}}{{with .PR}}
<h1>{{.Title}} <span class="muted">#{{.Number}}</span></h1>
<p class="pr-meta"><span class="chip pr-{{.State}}">{{.State}}</span> <b>{{.Author}}</b> wants to merge <code>{{.Head}}</code> into <code>{{.Base}}</code> · <span class="green">+{{.Additions}}</span> <span class="red">−{{.Deletions}}</span>{{range .Labels}} <span class="chip">{{.}}</span>{{end}}{{if .URL}} · <a href="{{.URL}}" target="_blank" rel="noopener noreferrer">Open on GitHub ↗</a>{{end}}</p>
<p class="pr-status">checks <b class="pr-{{.Checks}}">{{.Checks}}</b> · review <b class="pr-{{.Review}}">{{.Review}}</b> · merge <b class="pr-{{.MergeState}}">{{.MergeState}}</b>{{if eq .Mergeable "conflicting"}} <span class="red">(conflicts)</span>{{end}}{{if .AutoMerge}} · <span class="blue">{{if .Queue}}in the merge queue{{else}}auto-merge ({{.AutoMerge}}){{end}}</span>{{end}}</p>

{{if eq .State "open" "draft"}}<div class="actions pr-actions">
{{if eq .State "draft"}}<form method="post" action="{{$.ReadyURL}}" data-job="pr"><input type="hidden" name="number" value="{{.Number}}"><button class="ln">Ready for review</button></form>{{end}}
{{if $.Failed}}<form method="post" action="{{$.RerunURL}}" data-job="pr"><input type="hidden" name="number" value="{{.Number}}"><button class="ln">Rerun failed checks</button></form>{{end}}
{{if and (ne .State "draft") .Methods (not .AutoMerge)}}<form method="post" action="{{$.MergeURL}}" data-job="pr" data-confirm="Merge #{{.Number}} into {{.Base}}? It changes {{.Base}} for everyone." class="pr-merge">
<input type="hidden" name="number" value="{{.Number}}">
<select name="method" aria-label="Merge method">{{range .Methods}}<option value="{{.}}">{{.}}</option>{{end}}</select>
{{if .Queue}}<button class="ln main" name="auto" value="1">Add to merge queue</button>{{else}}{{if .AutoMergeAllowed}}<button class="ln" name="auto" value="1" title="GitHub merges it once its checks and reviews pass">Merge when ready</button>{{end}}
<button class="ln main"{{if not (eq .MergeState "clean" "unstable" "has_hooks")}} title="GitHub says {{.MergeState}}: it may refuse"{{end}}>Merge now</button>{{end}}
</form>{{end}}
</div>{{end}}

{{if .Body}}<section class="pr-body"><div class="md" data-md>{{.Body}}</div></section>{{end}}

<h2>Checks <span class="muted">{{len .CheckRuns}}</span></h2>
{{if .CheckRuns}}<ul class="pr-checks">{{range .CheckRuns}}<li><span class="pr-{{.State}}">{{if eq .State "pass"}}✓{{else if eq .State "fail"}}✗{{else if eq .State "pending"}}●{{else}}–{{end}}</span> {{if .URL}}<a href="{{.URL}}" target="_blank" rel="noopener noreferrer">{{.Name}}</a>{{else}}{{.Name}}{{end}}{{if .Workflow}} <span class="muted">{{.Workflow}}</span>{{end}}</li>{{end}}</ul>
{{else}}<p class="muted">No checks.</p>{{end}}

<h2>Review threads <span class="muted">{{$.Unresolved}} unresolved of {{len $.Threads}}</span></h2>
{{if $.Unresolved}}<form method="post" action="{{$.ActURL}}/agent" data-job="pr" data-confirm="Type the {{$.Unresolved}} unresolved review thread(s) into {{$.Slug}}'s agent? It starts the agent's session if it has none."><input type="hidden" name="number" value="{{.Number}}"><button class="ln main">Send all unresolved to the agent</button></form><form method="post" action="{{$.ActURL}}/agent" data-job="pr"><input type="hidden" name="number" value="{{.Number}}"><input type="hidden" name="queue" value="1"><button class="ln" title="Add them to {{$.Slug}}'s agent queue: typed in once it is idle">Queue for agent</button></form>{{end}}
{{range $.Threads}}<article class="pr-thread{{if .Resolved}} resolved{{end}}">
<header><code>{{.Path}}{{if .Line}}:{{.Line}}{{end}}</code>{{if .Outdated}} <span class="muted">outdated</span>{{end}}{{if .Resolved}} <span class="green">resolved</span>{{end}}</header>
{{if .Tail}}<pre class="pr-hunk">{{.Tail}}</pre>{{end}}
{{range .Comments}}<div class="pr-tc"><b>{{.Author}}</b> <span class="muted">{{.Created}}</span>{{if .URL}} <a href="{{.URL}}" target="_blank" rel="noopener noreferrer">↗</a>{{end}}<div class="md" data-md>{{.Body}}</div></div>{{end}}
<div class="pr-tactions">
<form method="post" action="{{$.ActURL}}/agent" data-job="pr"><input type="hidden" name="number" value="{{$.PR.Number}}"><input type="hidden" name="thread" value="{{.ID}}"><button class="ln" title="Type this thread into {{$.Slug}}'s agent">Send to agent</button><button class="ln" name="queue" value="1" title="Add it to {{$.Slug}}'s agent queue: typed in once it is idle">Queue for agent</button></form>
<form method="post" action="{{$.ActURL}}/{{if .Resolved}}unresolve{{else}}resolve{{end}}" data-job="pr"><input type="hidden" name="thread" value="{{.ID}}"><button class="ln">{{if .Resolved}}Unresolve{{else}}Resolve{{end}}</button></form>
</div>
<form method="post" action="{{$.ActURL}}/reply" data-job="pr" class="pr-reply"><input type="hidden" name="thread" value="{{.ID}}"><textarea name="body" rows="2" placeholder="Reply…" required></textarea><button class="ln">Reply</button></form>
</article>
{{else}}<p class="muted">No review threads.</p>{{end}}

<h2>Conversation <span class="muted">{{len .Reviews}} reviews · {{len .Comments}} comments</span></h2>
{{range .Reviews}}<article class="pr-note"><header><b>{{.Author}}</b> <span class="pr-{{.State}}">{{.State}}</span> <span class="muted">{{.Submitted}}</span></header>{{if .Body}}<div class="md" data-md>{{.Body}}</div>{{end}}</article>
{{end}}{{range .Comments}}<article class="pr-note"><header><b>{{.Author}}</b> <span class="muted">{{.Created}}</span>{{if .URL}} <a href="{{.URL}}" target="_blank" rel="noopener noreferrer">↗</a>{{end}}</header><div class="md" data-md>{{.Body}}</div></article>
{{end}}{{if not (or .Reviews .Comments)}}<p class="muted">No reviews or comments yet.</p>{{end}}
<form method="post" action="{{$.ActURL}}/comment" data-job="pr" class="pr-reply"><input type="hidden" name="number" value="{{.Number}}"><textarea name="body" rows="3" placeholder="Comment on the PR…" required></textarea><button class="ln">Comment</button></form>
{{if eq .State "open" "draft"}}<form method="post" action="{{$.ActURL}}/review" data-job="pr" class="pr-reply pr-review"><input type="hidden" name="number" value="{{.Number}}"><textarea name="body" rows="3" placeholder="Review summary (optional to approve)…"></textarea>
<div class="btns"><span class="muted">Review:</span><button class="ln" name="verdict" value="comment">Comment only</button><button class="ln" name="verdict" value="request-changes">Request changes</button><button class="ln main" name="verdict" value="approve">Approve</button></div></form>{{end}}

<h2>Files <span class="muted">{{len .Files}}</span></h2>
<ul class="pr-files">{{range .Files}}<li><span class="green">+{{.Additions}}</span> <span class="red">−{{.Deletions}}</span> <code>{{.Path}}</code>{{if ne .Change "modified"}} <span class="muted">{{.Change}}</span>{{end}}</li>{{end}}</ul>
{{end}}{{end}}
</section>
<section class="pane">
{{template "jobs" .Jobs}}
</section>
</main>
{{template "common-dialogs" .}}
</body>
</html>{{end}}
