{{define "settings"}}<!doctype html>
<html lang="en">
{{template "head" .}}
<body data-prefix="{{.Prefix}}" data-view="settings" data-preview="{{.PreviewURL}}">
{{template "top" .}}
<main class="grid settings">
<section class="left set-left">
<div class="set-hd"><div><div class="crumb"><a href="/p/{{.Prefix}}">← {{.Prefix}}</a></div>
<h1>Settings</h1></div><span class="sp"></span>
{{if not .Error}}<details class="tpl-save"><summary class="ln dim">Save as template</summary>
<div class="tpl-save-body"><form method="post" action="{{.Template.ExportURL}}" class="add-row" data-job="template-export">
<input name="name" placeholder="name" class="mono" autocomplete="off" spellcheck="false" required pattern="[a-z][a-z0-9\-]*" aria-label="Template name">
<input name="version" type="number" min="1" step="1" value="1" class="mono" required aria-label="Template version">
<button class="ln">Save</button>
</form>
<p class="note">Writes <span class="mono">~/.config/railswitch/templates/&lt;name&gt;.stack/</span> for every project on this machine: the stack, options, pins, env and secret names as questions with this project's values as defaults, and the Containerfiles you edited. The project's name, prefix and repository stay out; so do secret values. A version already saved is refused: save a higher one.</p></div>
</details>
{{end}}<a class="ln dim" href="{{.FileURL}}" title="For services, routes, agents, image, tools and versions">Edit project.toml</a></div>
{{if .Error}}<p class="red set-error">project.toml: {{.Error}}</p>
{{else}}{{with .Project}}<p class="set-proj"><b>{{.Name}}</b> · <span class="mono">{{.Repo}}</span> · base <span class="mono">{{.BaseBranch}}</span> · prefix <span class="mono">{{.Prefix}}</span></p>
{{end}}<p class="note">Changes are staged, not applied. The panel on the right shows what each one does before anything happens.</p>
{{template "settings-template" .Template}}{{template "tabs" .Tabs}}

<section class="spanel" data-spanel="stack">
<h2>Stack and options</h2>
<div class="sopts">{{with .Pack}}{{template "sopt" .}}{{end}}{{range .Options}}{{if not .Unused}}{{template "sopt" .}}{{end}}{{end}}</div>
<div class="sopts unused">{{range .Options}}{{if .Unused}}{{template "sopt" .}}{{end}}{{end}}</div>
<details class="more"><summary>Add another service</summary>
<form class="add-row" data-stage="service">
<input name="key" placeholder="service name" class="mono" autocomplete="off" required aria-label="Service name">
<select name="ref" required aria-label="Option">{{range .Project.AddChoices}}<option value="{{.}}">{{.}}</option>{{end}}</select>
<button class="ln" disabled>Add</button>
</form>
<p class="note">A name that is not a slot runs an option as one more service, named after it (a second database, ClickHouse beside Postgres).</p>
</details>
</section>

{{with .Firewall}}<section class="spanel" data-spanel="firewall" id="firewall" data-mode="{{.Mode}}">
<h2>Firewall</h2>
<p class="note">What each kind of container may reach outside this machine. Now: <b>{{.Effective}}</b>.</p>
<details class="more"><summary>How the modes work</summary><p class="note">The default is {{.Default}}{{if eq .Default "enforce"}}: the project has agents, and an agent edits the code the app, its workers and installs run{{end}}. Under enforce a host not listed is blocked; log only records what enforce would block.</p></details>
{{if .OptedOut}}<p class="yellow notice">This project has agents and its firewall is {{.Effective}}: an agent can reach the network through code the app or its workers run. Pick Default or Enforce to close that.</p>
{{end}}
<div class="choices fw-modes">{{range .Modes}}<label class="choice"><input type="radio" name="fw-mode" value="{{.Value}}"{{if .Current}} checked{{end}}> {{.Label}}</label>{{end}}</div>
<div id="fw-blocked" data-src="{{.BlockedURL}}"><p class="muted">Reading what the firewall blocked…</p></div>
<h3>Allowed hosts <span class="muted">· beyond the packages' own lists</span></h3>
<table class="set-table">
<thead><tr><th>Host</th><th>For</th><th></th></tr></thead>
<tbody>
{{range .Hosts}}<tr class="fwhost" data-prof="{{.Prof}}" data-host="{{.Host}}"><td class="mono">{{.Host}}</td><td><span class="mono">{{.Prof}}</span> <span class="muted">· {{.Note}}</span></td><td class="act"><button type="button" class="ln rm" data-fw-remove>Remove</button></td></tr>
{{else}}<tr><td colspan="3" class="muted">Nothing beyond the packages' own lists.</td></tr>
{{end}}</tbody>
</table>
<form class="add-row" data-stage="fw">
<input name="value" placeholder="host.example.com" class="mono" autocomplete="off" required aria-label="Host">
<select name="key" aria-label="For">{{range .Profiles}}<option value="{{.Name}}">{{.Name}} · {{.Note}}</option>{{end}}</select>
<button class="ln" disabled>Allow</button>
</form>
</section>
{{end}}<section class="spanel" data-spanel="commands" id="hooks">
<h2>Commands</h2>
<p class="note">Commands railswitch runs for you inside the containers, one per line, top to bottom.</p>
<details class="more"><summary>How they run</summary><p class="note">Each hook command runs in its own shell in <code>/app</code>. A failing <b>deps</b> or <b>start</b> command stops the app's start; a failing <b>create</b> command runs again on the next up. Agent setup is for tools an agent's home keeps, like gh extensions and agent skills. A failing setup command is reported and the agent starts anyway; the next start goes on from it (the ones before don't run again). Setup commands run without a terminal: pass the flags that answer their questions (gh skill install: a skill or --all, and --agent). Agents are yours: templates leave them out.</p></details>
<h3>App hooks</h3>
{{range .Hooks}}<label class="field hook cmd-row" data-list="{{.Name}}" data-orig="{{.Text}}"><span><span class="mono">{{.Name}}</span><br><span class="muted">{{.Note}}</span></span>
<textarea class="mono hook-cmds" rows="2" spellcheck="false" autocomplete="off" placeholder="e.g. {{if eq .Name "deps"}}gem list -i retest >/dev/null || gem install retest{{else if eq .Name "start"}}bin/rails db:test:prepare{{else}}bin/rails db:seed{{end}}">{{.Text}}</textarea></label>
{{end}}{{if gt (len .AgentSetups) 1}}<h3 id="agent-default">Default agent <span class="muted">· runs for <code>railswitch agent</code> without a name, and takes the work queue</span></h3>
<label class="field agent-default-pick" data-orig="{{.DefaultAgent}}">Agent <select class="agent-default-sel">{{if not .DefaultAgent}}<option value="">not set</option>{{end}}{{range .AgentSetups}}<option value="{{.Name}}"{{if eq .Name $.DefaultAgent}} selected{{end}}>{{.Name}}</option>{{end}}</select></label>
<p class="note">A running agent keeps running. <code>up</code> starts the default agent, when it runs as a service, only in a worktree where no agent runs: stop the old one first to switch.</p>
{{end}}{{with .AgentSetups}}<h3 id="agent-setup">Agent setup <span class="muted">· in the agent's own container before it first starts, and again when changed</span></h3>
{{range .}}<label class="field agent-setup cmd-row" data-agent="{{.Name}}" data-orig="{{.Text}}"><span class="mono">{{.Name}}</span>
<textarea class="mono agent-setup-cmds" rows="2" spellcheck="false" autocomplete="off" placeholder="e.g. gh extension install github/gh-stack --force">{{.Text}}</textarea></label>
{{end}}{{end}}</section>

<section class="spanel" data-spanel="env">
<h2>Environment</h2>
<p class="note">The project's <code>[env]</code>, given to the app.</p>
<table class="set-table" id="env-table">
<thead><tr><th>Name</th><th>Value</th><th></th></tr></thead>
<tbody>
{{range .Project.Env}}<tr class="env" data-name="{{.Name}}" data-value="{{.Value}}"><td class="mono">{{.Name}}</td><td><input class="mono env-value" value="{{.Value}}" autocomplete="off" aria-label="{{.Name}}"></td><td class="act"><button type="button" class="ln rm" data-env-remove>Remove</button></td></tr>
{{else}}<tr class="env-none"><td colspan="3" class="muted">No project env.</td></tr>
{{end}}</tbody>
</table>
<form class="add-row" data-stage="env">
<input name="name" placeholder="NAME" class="mono" autocomplete="off" required aria-label="Name">
<input name="value" placeholder="value" class="mono" autocomplete="off" aria-label="Value">
<button class="ln" disabled>Add</button>
</form>
</section>

<section class="spanel" data-spanel="links">
<h2>Worktree links</h2>
<p class="note">Links shown on each worktree. <code>{worktree.host}</code>, <code>{worktree.slug}</code> and <code>{branch}</code> are filled in per worktree.</p>
<table class="set-table">
<thead><tr><th>Show</th><th>Label</th><th>Address</th><th>From</th><th></th></tr></thead>
<tbody>
{{range .Links}}<tr class="link" data-label="{{.Label}}" data-hidden="{{.Hidden}}">
<td>{{if .Own}}<input type="checkbox" checked disabled title="A project link always shows">{{else}}<input type="checkbox" class="link-show"{{if not .Hidden}} checked{{end}} aria-label="Show {{.Label}}">{{end}}</td>
<td>{{.Label}}</td><td class="mono addr">{{.URL}}</td><td class="muted">{{.From}}</td>
<td class="act">{{if .Own}}<button type="button" class="ln rm" data-link-remove>Remove</button>{{end}}</td>
</tr>
{{else}}<tr><td colspan="5" class="muted">No links.</td></tr>
{{end}}</tbody>
</table>
<form class="add-row" data-stage="link">
<input name="label" placeholder="Label" autocomplete="off" required aria-label="Label">
<input name="url" placeholder="{worktree.host}/path" class="mono" autocomplete="off" required aria-label="Address">
<button class="ln" disabled>Add</button>
</form>
</section>

<section class="spanel" data-spanel="tasks" id="tasks">
<h2>Tasks</h2>
<p class="note">Commands you run from the <kbd>:</kbd> palette or <code>railswitch task &lt;name&gt;</code>. A pack task you change becomes the project's.</p>
<details class="more"><summary>More</summary><p class="note">The project's <code>[tasks]</code> over the pack's, run in the app with <code>sh -c</code> in <code>/app</code>. Hide keeps a pack task from the list (<code>name = ""</code>); Restore brings it back. A task with New container ticked (<code>fresh_tasks</code>) always runs in a throwaway container of the app image, never the running app: for a watcher such as retest. A task with Terminal ticked (<code>terminal_tasks</code>) opens in a terminal panel from the <kbd>:</kbd> palette, not as a job: for anything you watch or type into.</p></details>
<table class="set-table">
<thead><tr><th>Name</th><th>Command</th><th>From</th><th title="Runs in a new container, never the running app">New container</th><th title="The dashboard opens it in a terminal panel, not as a job">Terminal</th><th></th></tr></thead>
<tbody>
{{range .Project.Tasks}}<tr class="task" data-name="{{.Name}}" data-source="{{.Source}}" data-command="{{.Command}}" data-fresh="{{.Fresh}}" data-terminal="{{.Terminal}}" data-stock="{{.Pack}}">
<td class="mono">{{.Name}}</td>
<td>{{if eq .Source "hidden"}}<span class="mono muted">{{.Pack}}</span>{{else}}<input class="mono task-cmd" value="{{.Command}}" autocomplete="off" spellcheck="false" aria-label="Command of {{.Name}}">{{end}}</td>
<td class="muted">{{if eq .Source "hidden"}}pack, hidden{{else if and (eq .Source "project") .Pack}}project, over the pack's{{else}}{{.Source}}{{end}}</td>
<td>{{if ne .Source "hidden"}}<input type="checkbox" class="task-fresh"{{if .Fresh}} checked{{end}} aria-label="Run {{.Name}} in a new container">{{end}}</td>
<td>{{if ne .Source "hidden"}}<input type="checkbox" class="task-terminal"{{if .Terminal}} checked{{end}} aria-label="Open {{.Name}} in a terminal">{{end}}</td>
<td class="act">{{if eq .Source "hidden"}}<button type="button" class="ln rm" data-task-restore>Restore</button>{{else if eq .Source "pack"}}<button type="button" class="ln rm" data-task-hide>Hide</button>{{else if .Pack}}<button type="button" class="ln rm" data-task-remove title="{{.Pack}}">Back to the pack's</button>{{else}}<button type="button" class="ln rm" data-task-remove>Remove</button>{{end}}</td>
</tr>
{{else}}<tr><td colspan="6" class="muted">No tasks.</td></tr>
{{end}}</tbody>
</table>
<form class="add-row" data-stage="task">
<input name="name" placeholder="name" class="mono" autocomplete="off" spellcheck="false" required aria-label="Task name" value="{{.NewTask}}">
<input name="value" placeholder="e.g. bin/rails db:seed" class="mono" autocomplete="off" spellcheck="false" required aria-label="Task command"{{if .NewTask}} autofocus{{end}}>
<label class="fresh"><input type="checkbox" name="fresh"> New container</label>
<label class="fresh"><input type="checkbox" name="terminal"> Terminal</label>
<button class="ln" disabled>Add</button>
</form>
</section>

<section class="spanel" data-spanel="secrets">
<h2>Secrets</h2>
<p class="note">A value goes to podman on stdin and is never shown again. Secrets act at once; they are not staged. Running containers get a new value when they restart.</p>
{{if .SecretsError}}<p class="red">{{.SecretsError}}</p>
{{end}}<table class="set-table">
<thead><tr><th>Name</th><th>Services</th><th>Delivery</th><th>Value</th><th></th></tr></thead>
<tbody>
{{range .Secrets}}<tr class="secret"><td class="mono">{{.Name}}</td><td class="mono">{{.Services}}</td><td class="mono">{{.Delivery}}</td><td class="when">{{if .Set}}<span class="green">set {{.When}}</span>{{else}}<span class="yellow">not set</span>{{end}}</td>
<td class="act"><button type="button" class="ln" data-secret-set="{{.Name}}">Set value</button></td></tr>
{{else}}<tr><td colspan="5" class="muted">No secrets declared.</td></tr>
{{end}}</tbody>
</table>
<form method="post" action="{{.SecretURL}}" class="secret-form secret-set" data-job="secret" hidden>
<input type="hidden" name="name">
<label>New value for <span class="mono" data-secret-name></span> <input type="password" name="value" required autocomplete="off"></label>
<button class="ln main">Save</button><button type="button" class="ln rm" data-secret-cancel>Cancel</button>
</form>
<details class="add-secret">
<summary class="ln">Add a secret</summary>
<form method="post" action="{{.SecretURL}}" class="secret-form" data-job="secret">
<input type="hidden" name="add" value="1">
<label>Name <input name="name" required class="mono" autocomplete="off"></label>
<fieldset><legend>Services that receive it</legend>{{range .Services}}<label class="check"><input type="checkbox" name="services" value="{{.}}"> <span class="mono">{{.}}</span></label>{{else}}<span class="muted">No services known yet.</span>{{end}}</fieldset>
<label>Env variable <input name="env" class="mono" autocomplete="off" placeholder="empty: the file /run/secrets/&lt;name&gt;"></label>
<label>Value <input type="password" name="value" required autocomplete="off"></label>
<div class="btns"><button class="ln main">Add secret</button></div>
</form>
</details>
</section>
{{end}}</section>
<section class="pane">
{{template "staged" .Staged}}
{{template "jobs" .Jobs}}
</section>
</main>
{{template "common-dialogs" .}}
</body>
</html>
{{end}}

{{/* settings-template is the notice of a template that changed since
the project was made from it; Accept records its new version. */}}
{{define "settings-template"}}{{if .Update}}<section class="card tpl-notice" id="template">
<h2>Template changed</h2>
<p>The template <span class="mono">{{.Ref}}</span> changed since this project was made from it{{if .Since}} (<span class="mono">{{.Since}}</span>){{end}}. Nothing is applied: change what you want here or on the Images page. <code>railswitch template check</code> in the workspace shows the diff.</p>
{{if .Error}}<p class="red set-error">{{.Error}}</p>
{{else}}<form method="post" action="{{.AcceptURL}}" class="btns start" data-job="template-accept">
<input type="hidden" name="sha256" value="{{.SHA256}}">
<button class="ln main">Accept</button>
</form>
<p class="note">Accept records the template's version now (<span class="mono">{{.SHA256}}</span>): the notice goes away until it changes again.</p>
{{end}}</section>
{{end}}{{end}}

{{/* sopt is one stack choice: the pack or an option, as a select. */}}
{{define "sopt"}}<label class="sopt{{if .Unused}} muted{{end}}"{{if eq .Key "pack"}} data-pack{{end}} data-key="{{.Key}}" data-ref="{{.Ref}}"><span class="sopt-key"><b>{{.Key}}</b>{{if not .Slot}} <span class="muted">extra</span>{{end}}</span><select class="mono">{{range .Choices}}<option value="{{.Ref}}"{{if .Current}} selected{{end}}>{{.Ref}}</option>{{end}}</select></label>{{end}}

{{/* fw-blocked is the Firewall tab's blocked list, loaded after the
page: a group per container, the most refused name first. */}}
{{define "fw-blocked"}}<div id="fw-blocked" data-count="{{.Count}}">
{{if .Error}}<p class="red">Firewall state unavailable: {{.Error}}</p>
{{else}}<div class="fw-hd"><h3>{{.Title}}{{if .Count}} <span class="need">· {{.Count}}</span>{{end}}</h3>{{if .Groups}}<span class="muted">Allow stages the host into project.toml. Allow until restart and Allow for open it in the running container only.</span>{{end}}{{if .Count}}<button type="button" class="ln" data-fw-allow-selected disabled>Allow selected</button>{{end}}</div>
{{if .Groups}}<table class="set-table fw-rows">
<colgroup><col class="c-pick"><col><col class="c-why"><col class="c-n"><col class="c-act"></colgroup>
{{range .Groups}}<tbody>
<tr class="fw-group"><th colspan="5" scope="rowgroup"><span class="mono">{{.Container}}</span> <span class="chip">{{.Mode}}</span>{{if .Profile}} <span class="muted">· goes to the {{.Profile}} list</span>{{end}}</th></tr>
{{range .Rows}}<tr><td class="pick">{{if .CanList}}<input type="checkbox" class="fw-pick" data-prof="{{.Profile}}" data-host="{{.Host}}" aria-label="Select {{.Host}}">{{end}}</td><td class="mono addr">{{if .Host}}{{.Host}}{{else}}{{.Addr}}{{end}}</td><td class="muted">{{.Reason}}</td><td class="muted num">{{if .Count}}{{.Count}} tries{{end}}</td><td class="act">{{if .Own}}<span class="muted">this project's own service: nothing to allow</span>{{else if .CanList}}<button type="button" class="ln" data-fw-allow data-prof="{{.Profile}}" data-host="{{.Host}}" title="Stage it into project.toml: every {{.Profile}} container gets it from its next start">Allow</button>{{if .Service}}<form class="fw-live" method="post" action="/p/{{$.Prefix}}/{{.Slug}}/fw-allow/{{.Service}}" data-post><input type="hidden" name="host" value="{{.Host}}">{{if .Refused}}<input type="hidden" name="for" value="restart"><button class="ln quiet" title="Allow it in this running container now, until it restarts">Allow until restart</button>{{else}}<button class="ln quiet" title="Allow it in this running container now, until the time runs out">Allow for</button><select name="for" aria-label="How long"><option value="10m">10 minutes</option><option value="1h">1 hour</option><option value="restart">until it restarts</option></select>{{end}}</form>{{end}}{{else if not .Profile}}<span class="muted">a data container: nothing to allow</span>{{else}}<span class="muted">no host name: add the host by hand</span>{{end}}</td></tr>
{{end}}</tbody>
{{end}}</table>
{{else}}<p class="muted">Nothing blocked since the containers started.</p>
{{end}}{{range .None}}<p class="yellow notice"><span class="mono">{{.}}</span> has no firewall: the hook did not run for it (railswitch doctor, then restart it).</p>
{{end}}{{with .LAN}}<h3>LAN exceptions</h3>
<p class="muted">This machine's config.toml <span class="mono">[[lan]]</span> lets these containers past the never-allowed ranges, to one address and TCP port each.</p>
<ul class="mono">{{range .}}<li>{{.}}</li>{{end}}</ul>
{{end}}{{end}}</div>
{{end}}
