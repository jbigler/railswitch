{{/* The Database tab's content (#222): the snapshots and the starting
data, loaded each time the tab shows, outside the detail the event stream
redraws. Every button is a job; restore, delete and Use ask first. */}}
{{define "db-panel"}}<div class="db-panel" data-slug="{{.Slug}}">
<section class="dcard"><h2 class="lbl">Snapshots</h2>
<p class="muted">Named copies of this worktree's databases and storage, to restore here later. A snapshot is a <code>db dump</code> kept by name; Restore resets the databases and storage to it. The database must be running.</p>
{{template "snapshots-take" .}}{{template "snapshots-table" .}}
</section>
<section class="dcard"><h2 class="lbl">Starting data</h2>
<p class="muted">A new worktree starts from the workspace's <code>db-dumps/</code>.</p>
{{if .Written}}<p>{{len .DumpFiles}} file{{if ne (len .DumpFiles) 1}}s{{end}}, {{.DumpSize}}, last written <span class="mono">{{.Written}}</span>: {{range $i, $f := .DumpFiles}}{{if $i}}, {{end}}<code>{{$f}}</code>{{end}}</p>
{{else}}<p>There is none: <code>db-dumps/</code> holds no dumps.</p>
{{end}}<form method="post" action="{{.DumpURL}}" data-post data-confirm="Use {{.Slug}}'s data as the starting data of new worktrees? It replaces the dumps in db-dumps/; the database must be running."><div class="btns start"><button class="ln"{{if .Stopped}} disabled title="Start the worktree first: its database must be running"{{end}}>Use this worktree's data</button></div></form>
</section>
</div>{{end}}

{{define "snapshots-take"}}<form method="post" action="{{.TakeURL}}" data-post data-close>
<label>Name <input name="name" placeholder="a timestamp" autocomplete="off" class="mono"></label>
<div class="btns"><button class="ln main"{{if .Stopped}} disabled title="Start the worktree first: its database must be running"{{end}}>Take a snapshot</button></div>
</form>{{end}}

{{define "snapshots-table"}}{{if .Snapshots}}<table class="set-table">
<thead><tr><th>Name</th><th>Taken</th><th>Size</th><th></th></tr></thead>
<tbody>
{{range .Snapshots}}<tr><td class="mono">{{.Name}}</td><td class="mono">{{.Created}}</td><td class="mono">{{.Size}}</td>
<td><form method="post" action="{{$.RestoreURL}}" data-post data-close data-confirm="Restore {{.Name}} into {{$.Slug}}? What its databases and storage hold now is lost."><input type="hidden" name="name" value="{{.Name}}"><button class="ln"{{if $.Stopped}} disabled title="Start the worktree first: its database must be running"{{end}}>Restore</button></form>
<form method="post" action="{{$.RmURL}}" data-post data-close data-confirm="Delete snapshot {{.Name}}?"><input type="hidden" name="name" value="{{.Name}}"><button class="ln danger">Delete</button></form></td></tr>
{{end}}</tbody>
</table>
{{else}}<p class="muted">No snapshots yet.</p>
{{end}}{{end}}

{{/* A worktree's database snapshots (D157), as a dialog: the down
dialog offers one first. */}}
{{define "snapshots"}}<div class="snapshots">
<h2>Database snapshots of {{.Slug}}</h2>
{{template "snapshots-take" .}}{{template "snapshots-table" .}}<p class="note">A snapshot is a <code>db dump</code> kept by name for this worktree. Restore resets its databases and storage to it; the database must be running.</p>
<div class="btns"><button type="button" class="ln" data-cancel>Close</button></div>
</div>{{end}}
