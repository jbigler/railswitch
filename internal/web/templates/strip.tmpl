{{define "strip"}}<div id="strip" class="strip"{{if not .Items}} hidden{{end}}>{{range .Items}}<a href="{{.URL}}">{{.Text}}</a>{{end}}</div>{{end}}

{{define "banner"}}<div id="banner" class="banner"{{if not (or .Lines .Review .Signers .Template)}} hidden{{end}}>{{range .Lines}}<div>{{.}}</div>{{end}}{{if .Review}}<div class="rv-banner">Package update waiting for review. <a href="{{.Review}}">Review update</a></div>{{end}}{{range .Signers}}<div class="signer-warning">{{.}}</div>{{end}}{{with .Template}}<div class="tpl-banner">The template <span class="mono">{{.Ref}}</span> changed since this project was made from it. <a href="{{.URL}}">See it in Settings</a></div>{{end}}</div>{{end}}
