{{define "strip"}}<div id="strip" class="strip"{{if not .Items}} hidden{{end}}>{{range .Items}}<a href="{{.URL}}">{{.Text}}</a>{{end}}</div>{{end}}

{{define "banner"}}<div id="banner" class="banner"{{if not (or .Lines .Review .Signers)}} hidden{{end}}>{{range .Lines}}<div>{{.}}</div>{{end}}{{if .Review}}<div class="rv-banner">Package update waiting for review. <a href="{{.Review}}">Review update</a></div>{{end}}{{range .Signers}}<div class="signer-warning">{{.}}</div>{{end}}</div>{{end}}
