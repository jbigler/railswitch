["-C","/ws","containerfile","show","base"]
{"name":"base","file":"containerfiles/Containerfile.base","kind":"base","text":"# The rails pack's default base image (D31): app, deps and worker run it, and\n# every addon and tool image is built on top of it. railswitch passes\n# RUBY_VERSION, NODE_VERSION and BUN_VERSION from the worktree's own version\n# files; BUN_VERSION is empty unless the app pins bun (D69).\n#\n# Database clients are not here: the database option's addon adds them\n# (postgres: Containerfile.pg-client). Nothing is read from the build context.\nARG RUBY_VERSION\nARG NODE_VERSION\nARG BUN_VERSION\n\n# Node, only to copy its runtime into the image below.\nFROM docker.io/library/node:${NODE_VERSION}-slim AS node\n\nFROM docker.io/library/ruby:${RUBY_VERSION}-slim\n\nSHELL [\"/bin/bash\", \"-o\", \"pipefail\", \"-c\"]\nARG BUN_VERSION\n\n# What a Rails app needs to build its gems and run: compilers and headers for\n# native extensions, git for git-sourced gems, curl for the health check,\n# libvips for Active Storage variants, jemalloc for a smaller Ruby heap.\nRUN apt-get update -qq \u0026\u0026 \\\n  apt-get install --no-install-recommends -y \\\n  build-essential \\\n  ca-certificates \\\n  curl \\\n  git \\\n  libffi-dev \\\n  libjemalloc2 \\\n  libssl-dev \\\n  libvips \\\n  libyaml-dev \\\n  openssh-client \\\n  pkg-config \\\n  sqlite3 \\\n  tzdata \\\n  zlib1g-dev \u0026\u0026 \\\n  rm -rf /var/lib/apt/lists/* \u0026\u0026 \\\n  ln -s \"/usr/lib/$(uname -m)-linux-gnu/libjemalloc.so.2\" /usr/local/lib/libjemalloc.so\n\nENV LD_PRELOAD=/usr/local/lib/libjemalloc.so\n\nCOPY --from=node /usr/local/bin /usr/local/bin\nCOPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules\n\n# yarn and pnpm through corepack, at the version package.json's\n# \"packageManager\" names. Node 25 and later no longer ship corepack, so it\n# comes from npm there. Without a prompt: deps runs unattended; without\n# auto-pin: corepack never writes \"packageManager\" into the app's\n# package.json. The node image's yarn and yarnpkg links point into its /opt,\n# which is not copied: corepack cannot replace a dangling link, so they go\n# first.\nENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0\nENV COREPACK_ENABLE_AUTO_PIN=0\nRUN rm -f /usr/local/bin/yarn /usr/local/bin/yarnpkg \u0026\u0026 \\\n  if ! command -v corepack \u003e/dev/null; then npm install -g --no-audit --no-fund corepack; fi \u0026\u0026 \\\n  corepack enable\n\n# bun, only when the app pins it (.bun-version or \"packageManager\": \"bun@…\").\nRUN if [ -n \"${BUN_VERSION}\" ]; then \\\n    case \"$(uname -m)\" in x86_64) arch=x64 ;; aarch64) arch=aarch64 ;; *) echo \"bun: no build for $(uname -m)\" \u003e\u00262; exit 1 ;; esac \u0026\u0026 \\\n    apt-get update -qq \u0026\u0026 apt-get install --no-install-recommends -y unzip \u0026\u0026 rm -rf /var/lib/apt/lists/* \u0026\u0026 \\\n    curl -fsSL -o /tmp/bun.zip \"https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/bun-linux-${arch}.zip\" \u0026\u0026 \\\n    unzip -q -j /tmp/bun.zip -d /usr/local/bin \u0026\u0026 rm /tmp/bun.zip \u0026\u0026 \\\n    ln -s bun /usr/local/bin/bunx; \\\n  fi\n\nRUN gem update --system \u0026\u0026 \\\n  gem install -N bundler\n\n# appuser is uid/gid 1000: keep-id maps the host user onto it. The directories\n# volumes are mounted on exist and belong to appuser, so a fresh volume copies\n# up appuser ownership; a parent the runtime had to create for a nested mount\n# would belong to root and nothing else could write there.\nRUN groupadd --gid 1000 appuser \u0026\u0026 \\\n  useradd --uid 1000 --gid 1000 --shell /bin/bash --create-home appuser \u0026\u0026 \\\n  mkdir -p /app \\\n  /usr/local/bundle \\\n  /home/appuser/.npm \\\n  /home/appuser/.npm-global \u0026\u0026 \\\n  chown -R 1000:1000 /app /usr/local/bundle /home/appuser\n\nENV NPM_CONFIG_PREFIX=/home/appuser/.npm-global\nENV PATH=/home/appuser/.local/bin:/home/appuser/.npm-global/bin:${PATH}:/app/node_modules/.bin\nENV SHELL=/bin/bash\n\nWORKDIR /app\nUSER appuser\n\nEXPOSE 3000\nCMD [\"bin/dev\"]\n","hash":"sha256:c40d7ffe1e4f5b257544067f815ed0f724da78ca8aa9ba11026bb4ce72d88414","default":{"ref":"rails@1","text":"# The rails pack's default base image (D31): app, deps and worker run it, and\n# every addon and tool image is built on top of it. railswitch passes\n# RUBY_VERSION, NODE_VERSION and BUN_VERSION from the worktree's own version\n# files; BUN_VERSION is empty unless the app pins bun (D69).\n#\n# Database clients are not here: the database option's addon adds them\n# (postgres: Containerfile.pg-client). Nothing is read from the build context.\nARG RUBY_VERSION\nARG NODE_VERSION\nARG BUN_VERSION\n\n# Node, only to copy its runtime into the image below.\nFROM docker.io/library/node:${NODE_VERSION}-slim AS node\n\nFROM docker.io/library/ruby:${RUBY_VERSION}-slim\n\nSHELL [\"/bin/bash\", \"-o\", \"pipefail\", \"-c\"]\nARG BUN_VERSION\n\n# What a Rails app needs to build its gems and run: compilers and headers for\n# native extensions, git for git-sourced gems, curl for the health check,\n# libvips for Active Storage variants, jemalloc for a smaller Ruby heap.\nRUN apt-get update -qq \u0026\u0026 \\\n  apt-get install --no-install-recommends -y \\\n  build-essential \\\n  ca-certificates \\\n  curl \\\n  git \\\n  libffi-dev \\\n  libjemalloc2 \\\n  libssl-dev \\\n  libvips \\\n  libyaml-dev \\\n  openssh-client \\\n  pkg-config \\\n  sqlite3 \\\n  tzdata \\\n  zlib1g-dev \u0026\u0026 \\\n  rm -rf /var/lib/apt/lists/* \u0026\u0026 \\\n  ln -s \"/usr/lib/$(uname -m)-linux-gnu/libjemalloc.so.2\" /usr/local/lib/libjemalloc.so\n\nENV LD_PRELOAD=/usr/local/lib/libjemalloc.so\n\nCOPY --from=node /usr/local/bin /usr/local/bin\nCOPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules\n\n# yarn and pnpm through corepack, at the version package.json's\n# \"packageManager\" names. Node 25 and later no longer ship corepack, so it\n# comes from npm there. Without a prompt: deps runs unattended; without\n# auto-pin: corepack never writes \"packageManager\" into the app's\n# package.json. The node image's yarn and yarnpkg links point into its /opt,\n# which is not copied: corepack cannot replace a dangling link, so they go\n# first.\nENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0\nENV COREPACK_ENABLE_AUTO_PIN=0\nRUN rm -f /usr/local/bin/yarn /usr/local/bin/yarnpkg \u0026\u0026 \\\n  if ! command -v corepack \u003e/dev/null; then npm install -g --no-audit --no-fund corepack; fi \u0026\u0026 \\\n  corepack enable\n\n# bun, only when the app pins it (.bun-version or \"packageManager\": \"bun@…\").\nRUN if [ -n \"${BUN_VERSION}\" ]; then \\\n    case \"$(uname -m)\" in x86_64) arch=x64 ;; aarch64) arch=aarch64 ;; *) echo \"bun: no build for $(uname -m)\" \u003e\u00262; exit 1 ;; esac \u0026\u0026 \\\n    apt-get update -qq \u0026\u0026 apt-get install --no-install-recommends -y unzip \u0026\u0026 rm -rf /var/lib/apt/lists/* \u0026\u0026 \\\n    curl -fsSL -o /tmp/bun.zip \"https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/bun-linux-${arch}.zip\" \u0026\u0026 \\\n    unzip -q -j /tmp/bun.zip -d /usr/local/bin \u0026\u0026 rm /tmp/bun.zip \u0026\u0026 \\\n    ln -s bun /usr/local/bin/bunx; \\\n  fi\n\nRUN gem update --system \u0026\u0026 \\\n  gem install -N bundler\n\n# appuser is uid/gid 1000: keep-id maps the host user onto it. The directories\n# volumes are mounted on exist and belong to appuser, so a fresh volume copies\n# up appuser ownership; a parent the runtime had to create for a nested mount\n# would belong to root and nothing else could write there.\nRUN groupadd --gid 1000 appuser \u0026\u0026 \\\n  useradd --uid 1000 --gid 1000 --shell /bin/bash --create-home appuser \u0026\u0026 \\\n  mkdir -p /app \\\n  /usr/local/bundle \\\n  /home/appuser/.npm \\\n  /home/appuser/.npm-global \u0026\u0026 \\\n  chown -R 1000:1000 /app /usr/local/bundle /home/appuser\n\nENV NPM_CONFIG_PREFIX=/home/appuser/.npm-global\nENV PATH=/home/appuser/.local/bin:/home/appuser/.npm-global/bin:${PATH}:/app/node_modules/.bin\nENV SHELL=/bin/bash\n\nWORKDIR /app\nUSER appuser\n\nEXPOSE 3000\nCMD [\"bin/dev\"]\n"},"ejected":null,"default_changed":false,"diff":""}
