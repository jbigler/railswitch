["project","new","/home/user/shop","--repo","file:///ws/worktrees/master","--prefix","shop","--template","filial-stack@1","--agent","none","--dry-run"]
{"project_toml":"schema = 1\nfresh_tasks = [\"test\"]\nterminal_tasks = [\"console\"]\n\n[project]\nname = \"shop\"\nprefix = \"shop\"\nrepo = \"file:///ws/worktrees/master\"\nbase_branch = \"master\"\n\n[stack]\npack = \"rails@1\"\napp = \"rails\"\n\n[options]                  # one per slot; \"none\" turns a slot off; another key adds a service of that name\ndatabase = \"postgres@1\"\ncache = \"redis@1\"\nstorage = \"rustfs@1\"\njobs = \"none\"\nmail = \"none\"\nbrowser = \"playwright@1\"\n\n[versions]                 # the options' image pins\npostgres = \"16\"\nredis = \"8\"\nrustfs = \"1.0.0-alpha.83\"\n\n[env]\nTZ = \"Asia/Bangkok\"\n\n[services.rails.env]\nHEADLESS_SYSTEM_TESTS = \"0\"\n\n[[links]]\nlabel = \"Admin\"\nurl = \"{worktree.host}/admin\"\n\n[firewall]\nallow.deps = [\"github.com\"]\n\n[template]                 # the template this project started from (D111): never applied again\nref = \"filial-stack@1\"\nsha256 = \"9128d86c63291fb2192c99cae7226e9dea31336de353cd2289c6440495bef700\"\n\n[image]\nbase = \"containerfiles/Containerfile.base\"\naddons = [\"containerfiles/Containerfile.pg-client\"]\n\n[secrets.twilio_auth_token]\nservices = [\"rails\"]\nenv = \"TWILIO_AUTH_TOKEN\"\n","worktree":{"slug":"master","routes":[{"host":"master.shop.localhost","service":"rails"},{"host":"s3.master.shop.localhost","service":"storage"},{"host":"s3-ui.master.shop.localhost","service":"storage"},{"host":"vnc.master.shop.localhost","service":"browser"}],"containers":[{"name":"shop-master-rails","role":"app"},{"name":"shop-master-deps","role":"deps"},{"name":"shop-master-db","role":"data"},{"name":"shop-master-cache","role":"data"},{"name":"shop-master-storage","role":"data"},{"name":"shop-master-browser","role":"tool"}],"env":["APP_PORT","BINDING","BROWSER_CPUS","COREPACK_HOME","DATABASE_URL","GIT_CONFIG_SYSTEM","HEADLESS_SYSTEM_TESTS","PGDATABASE","PGHOST","PGPASSWORD","PGPORT","PGUSER","PLAYWRIGHT_HOST","PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD","RAILS_DEVELOPMENT_HOSTS","RAILS_ENV","REDIS_URL","RUBY_DEBUG_HOST","RUBY_DEBUG_PORT","S3_ACCESS_KEY","S3_ENDPOINT","S3_SECRET_KEY","TZ","WORKTREE_HOST","WORKTREE_ID","WORKTREE_SLUG"]},"warnings":[],"steps":["Clone file:///ws/worktrees/master (master) into /home/user/shop/worktrees/master","Write project.toml and stack.lock, generate local passwords","Eject 3 Containerfiles","Register, lock and render"],"install":null,"template":{"ref":"filial-stack@1","sha256":"9128d86c63291fb2192c99cae7226e9dea31336de353cd2289c6440495bef700","ask":[{"key":"options.database","prompt":"Option for database (a ref, or none)","default":"postgres@1","answer":"postgres@1"},{"key":"options.cache","prompt":"Option for cache (a ref, or none)","default":"redis@1","answer":"redis@1"},{"key":"options.storage","prompt":"Option for storage (a ref, or none)","default":"rustfs@1","answer":"rustfs@1"},{"key":"options.jobs","prompt":"Option for jobs (a ref, or none)","default":"none","answer":"none"},{"key":"options.mail","prompt":"Option for mail (a ref, or none)","default":"none","answer":"none"},{"key":"options.browser","prompt":"Option for browser (a ref, or none)","default":"playwright@1","answer":"playwright@1"},{"key":"versions.postgres","prompt":"Version of postgres","default":"16","answer":"16"},{"key":"versions.redis","prompt":"Version of redis","default":"8","answer":"8"},{"key":"versions.rustfs","prompt":"Version of rustfs","default":"1.0.0-alpha.83","answer":"1.0.0-alpha.83"},{"key":"env.TZ","prompt":"Value of TZ","default":"Asia/Bangkok","answer":"Asia/Bangkok"}]}}
