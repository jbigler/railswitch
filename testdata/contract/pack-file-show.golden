["-C","/ws","pack","file","show","rails@1","pack.toml"]
{"path":"pack.toml","text":"name = \"rails\"\nversion = 1\n\n# DATABASE_URL without the database name: Rails applies DATABASE_URL (and a\n# database.yml url:) to whichever environment runs, so a name there would\n# point tests at the development database. Without it each environment\n# takes database.yml's own (…_development, …_test) on the same server.\ndb_url_name = false\n# The test database ({db_test}, from database.yml) and its parallel workers'\n# copies (Rails names them …-0; some apps …_0) live on the same server; db\n# dump leaves them out and restores ignore their dumps.\ndump_skip = [\"{db_test}\", \"{db_test}-[0-9]*\", \"{db_test}_[0-9]*\"]\n\n[app]\nservice = \"rails\"\nserver = \"bin/dev\"\nport = 3000\nhealth = \"curl -fsS http://localhost:3000/up\"   # Rails 7.1+ health route (D34)\nhealth_start_period = \"120s\"\nentrypoint = \"entrypoints/entrypoint-app.sh\"\ndeps_entrypoint = \"entrypoints/entrypoint-deps.sh\" # deps installs the lockfiles, frozen (D35); no install command\n\n[deps]\nfrozen_env = { BUNDLE_FROZEN = \"true\" }         # set on the deps service; `railswitch deps` leaves it out (D35)\n\n[image]                    # the base image (D31); app, deps and worker run it\nfile = \"Containerfile.base\"\ntag = \"ruby{ruby}-node{node}\"\nos = \"debian\"\nargs = { RUBY_VERSION = \"{ruby}\", NODE_VERSION = \"{node}\", BUN_VERSION = \"{bun}\" }\n\n[runtimes.ruby]\nfrom = [\".ruby-version\", \".tool-versions:ruby\", \"Gemfile\", \"Gemfile.lock\"]\nfallback = \"3.4.2\"\n\n[runtimes.node]\nfrom = [\".nvmrc\", \".node-version\", \".tool-versions:nodejs\", \"package.json\"]\nfallback = \"22.11.0\"\n\n[runtimes.bun]             # no fallback: an app that pins no bun version gets no bun in its image (D69)\nfrom = [\".bun-version\", \".tool-versions:bun\", \"package.json:packageManager.bun\"]\n\n[runtimes.playwright]\nfrom = [\"Gemfile.lock:playwright-ruby-client\"]\nfallback = \"1.60.0\"\n\n[db_name]\nfrom = [\"config/database.yml:development.database\"]\nfallback = \"{project.prefix}_development\"\n\n[db_test_name]             # {db_test}; else {db} with _development (or _dev) made _test\nfrom = [\"config/database.yml:test.database\"]\n\n\n[env]                      # only what Rails itself reads; app-specific names go in the project's [env]\nRAILS_ENV = \"development\"\nBINDING = \"0.0.0.0\"\nRUBY_DEBUG_HOST = \"0.0.0.0\"  # the debug port is published, so the debug gem listens on every container address\nCOREPACK_HOME = \"/home/appuser/.corepack\" # the shared corepack cache ([[caches]] corepack)\n# Rails' development host check allows only one subdomain under .localhost, so\n# it answers 403 for \u003cslug\u003e.\u003cprefix\u003e.localhost unless the host is added here.\nRAILS_DEVELOPMENT_HOSTS = \"{worktree.host}\"\n\n[share]                    # layer 7: only while the worktree is shared on the tailnet (D46)\nenv = { RAILS_DEVELOPMENT_HOSTS = \"{worktree.host},{share.host}\" }\n\n[db_scheme]\npostgres = \"postgres://\"\nmysql = \"mysql2://\"\nmariadb = \"mysql2://\"\n\n[[caches]]                 # shared across worktrees: \u003cprefix\u003e_\u003cname\u003e\nname = \"gems_ruby{ruby}\"\nmount = \"/usr/local/bundle\"\nchown = false\n\n[[caches]]\nname = \"npm_cache\"\nmount = \"/home/appuser/.npm\"\nchown = true\n\n[[caches]]                 # corepack's yarn and pnpm: deps fetches the version package.json names\nname = \"corepack\"          # (its `yarn --version`), the app reuses it without the network (D119);\nmount = \"/home/appuser/.corepack\" # not under ~/.cache: the runtime would make its parents root's\nchown = true\n\n[[worktree_volumes]]       # per worktree: \u003cprefix\u003e-\u003cslug\u003e-\u003cname\u003e\nname = \"node-modules\"\nmount = \"/app/node_modules\"\nchown = true\n\n[[ports]]\nname = \"debug\"\nenv = \"RUBY_DEBUG_PORT\"\nbase = 33000\nsame_port = true          # the container port is the host port, so RUBY_DEBUG_PORT is right inside the container too\n\n[[ports]]\nname = \"app\"\nenv = \"APP_PORT\"\nbase = 13000\ncontainer = 3000\nshare = true               # served on tailnet HTTPS port 13000+ID by railswitch share (D46)\n\n[defaults]\ndatabase = \"postgres@1\"\ncache = \"redis@1\"\nstorage = \"none\"\njobs = \"none\"\nmail = \"none\"\nbrowser = \"none\"           # opt-in: --option browser=playwright@1\n\n[tasks]\nconsole = \"bin/rails console\"\ntest = \"bin/rails test\"\n# One worker per browser CPU (D174): Rails' default is one per host core,\n# and past the browser's cap pages starve into Playwright's 5 s timeouts.\n# A PARALLEL_WORKERS of the project's wins; without a browser, Rails decides.\n\"test:system\" = \"env ${BROWSER_CPUS:+PARALLEL_WORKERS=${PARALLEL_WORKERS:-$BROWSER_CPUS}} bin/rails test:system\"\n\n[[links]]\nlabel = \"Mailer previews\"\nurl = \"{worktree.host}/rails/mailers\"\n\n[[links]]\nlabel = \"Routes\"\nurl = \"{worktree.host}/rails/info/routes\"\n\n[detect]                   # D87: railswitch project detect suggests this pack for a repo with every file\nfiles = [\"Gemfile\", \"config/application.rb\"]\n\n[unit]\n# stdin stays open (no tty, so no colour codes in the logs): a Procfile's\n# tailwindcss:watch ends at stdin's EOF, and foreman then stops the app\ninteractive = true\n","hash":"sha256:4a07229b9b51f2e9ff472cc08018c22907c876081085aebb1d199e82d160af40"}
