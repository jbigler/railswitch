["-C","/ws","project","show"]
{"prefix":"filial","name":"Filial Rails","repo":"git@github.com:[ORG]/[REPO].git","base_branch":"master","hash":"sha256:39c198649bc089ff105b5815752e294a58007951e6bce24eae7b3af5ca014d5f","file":"schema = 1\nfresh_tasks = [\"test\"]\nterminal_tasks = [\"console\"]\n\nfrom = \"rails-postgres-redis-rustfs@1\"      # template it came from (optional)\n\n[project]\nname        = \"Filial Rails\"\nprefix      = \"filial\"                     # unique on this machine; names objects and hosts\nrepo        = \"git@github.com:[ORG]/[REPO].git\"\nbase_branch = \"master\"\n\n[stack]\npack = \"rails@1\"\napp  = \"rails\"                             # the service with role app\n\n[options]                                  # one per slot; \"none\" turns a slot off\ndatabase = \"postgres@1\"\ncache    = \"redis@1\"\nstorage  = \"rustfs@1\"\njobs     = \"none\"\nmail     = \"none\"\nbrowser  = \"playwright@1\"\n\n[versions]                                 # pins for options' images;\npostgres = \"16\"                            # runtimes (ruby, node) come from the app's files\nredis    = \"8\"\nrustfs   = \"1.0.0-alpha.83\"\n\n# Only what differs from the pack and options:\n[env]\nTZ = \"Asia/Bangkok\"\n\n[services.rails.env]\nHEADLESS_SYSTEM_TESTS = \"0\"\n\n[worktrees.postgres-trial.versions]        # per-worktree override\npostgres = \"17\"\n\n[worktrees.feat.versions]\npostgres = \"17\"\n\n[secrets.twilio_auth_token]                # values live in podman secrets\nservices = [\"rails\"]\nenv      = \"TWILIO_AUTH_TOKEN\"\n\n[secrets.github_token]\nservices = [\"nvim\"]\n\n[secrets.probe_key]\nservices = [\"agent-probe\"]\n\n[tools.nvim]                               # the editor; its config is cloned from a git repo (D54)\nconfig_repo = \"https://github.com/[ORG]/nvim-config.git\"\n\n[agents.claude]\nuse = \"claude@1\"\nrun = \"on-demand\"                          # tests cover the one-shot path; the package runs a service\n\n[agents.probe]                             # test-only workspace package: agents/probe/\nuse = \"local:probe@1\"\nrun = \"service\"\n\n[firewall]\nallow.deps = [\"github.com\"]\n\n[[links]]                                  # Worktree links (see 3.10)\nlabel = \"Admin\"\nurl   = \"{worktree.host}/admin\"\n\n[image]\nbase = \"containerfiles/Containerfile.base\"\naddons = [\"containerfiles/Containerfile.pg-client\"]\n","pack":{"ref":"rails@1","choices":["acme:rails@1","rails@1"]},"firewall":{"mode":"","default":"enforce","effective":"enforce","allow":{"agent":[],"app":[],"deps":["github.com"]}},"hooks":{"deps":[],"start":[],"create":[]},"agents":[{"name":"claude","setup":[],"default":true},{"name":"probe","setup":[],"default":false}],"options":[{"key":"database","slot":true,"ref":"postgres@1","choices":["mariadb@1","postgres@1","none"]},{"key":"cache","slot":true,"ref":"redis@1","choices":["redis@1","acme:redis@1","none"]},{"key":"storage","slot":true,"ref":"rustfs@1","choices":["rustfs@1","none"]},{"key":"jobs","slot":true,"ref":"none","choices":["sidekiq@1","none"]},{"key":"mail","slot":true,"ref":"none","choices":["none"]},{"key":"browser","slot":true,"ref":"playwright@1","choices":["playwright@1","none"]}],"add_choices":["mariadb@1","playwright@1","postgres@1","redis@1","rustfs@1","sidekiq@1","acme:redis@1"],"used":["rails@1","postgres@1","redis@1","rustfs@1","playwright@1","claude@1","local:probe@1"],"env":[{"name":"TZ","value":"Asia/Bangkok"}],"links":[{"label":"Admin","url":"{worktree.host}/admin","from":"project","hidden":false},{"label":"Mailer previews","url":"{worktree.host}/rails/mailers","from":"pack rails@1","hidden":false},{"label":"Routes","url":"{worktree.host}/rails/info/routes","from":"pack rails@1","hidden":false},{"label":"Storage console","url":"s3-ui.{worktree.host}","from":"option rustfs@1","hidden":false},{"label":"Browser (VNC)","url":"vnc.{worktree.host}/vnc.html?autoconnect=1\u0026resize=scale","from":"option playwright@1","hidden":false}],"tasks":[{"name":"console","command":"bin/rails console","source":"pack","pack":"bin/rails console","terminal":true},{"name":"test","command":"bin/rails test","source":"pack","pack":"bin/rails test","fresh":true},{"name":"test:system","command":"env ${BROWSER_CPUS:+PARALLEL_WORKERS=${PARALLEL_WORKERS:-$BROWSER_CPUS}} bin/rails test:system","source":"pack","pack":"env ${BROWSER_CPUS:+PARALLEL_WORKERS=${PARALLEL_WORKERS:-$BROWSER_CPUS}} bin/rails test:system"}]}
