["template","import","/home/user/given"]
{"ref":"given@1","sha256":"befeb2f36d6b0f27d9d42f0ab8d2f9ccdfe0b024988f4023aec7a6842423f459","status":"new","replaces":null,"hash":"befeb2f36d6b0f27d9d42f0ab8d2f9ccdfe0b024988f4023aec7a6842423f459","flags":4,"packages":[{"ref":"given@1","kind":"template","status":"added","from":"","to":"befeb2f36d6b0f27d9d42f0ab8d2f9ccdfe0b024988f4023aec7a6842423f459","also_locked_in":[],"files":[{"path":"stack.toml","status":"added","diff":"--- /dev/null\n+++ b/stack.toml\n@@ -0,0 +1,88 @@\n+schema = 1\n+name = \"given\"\n+version = 1\n+\n+[stack]\n+pack = \"rails@1\"\n+app = \"rails\"\n+\n+[options]                  # one per slot; \"none\" turns a slot off; another key adds a service of that name\n+database = \"postgres@1\"\n+cache = \"redis@1\"\n+storage = \"rustfs@1\"\n+jobs = \"none\"\n+mail = \"none\"\n+browser = \"playwright@1\"\n+\n+[versions]                 # the options' image pins\n+postgres = \"16\"\n+redis = \"8\"\n+rustfs = \"1.0.0-alpha.83\"\n+\n+[env]\n+TZ = \"Asia/Bangkok\"\n+\n+[services.rails.env]\n+HEADLESS_SYSTEM_TESTS = \"0\"\n+\n+[[links]]\n+label = \"Admin\"\n+url = \"{worktree.host}/admin\"\n+\n+[firewall]\n+allow.deps = [\"github.com\"]\n+\n+[[ask]]\n+key = \"options.database\"\n+prompt = \"Option for database (a ref, or none)\"\n+default = \"postgres@1\"\n+\n+[[ask]]\n+key = \"options.cache\"\n+prompt = \"Option for cache (a ref, or none)\"\n+default = \"redis@1\"\n+\n+[[ask]]\n+key = \"options.storage\"\n+prompt = \"Option for storage (a ref, or none)\"\n+default = \"rustfs@1\"\n+\n+[[ask]]\n+key = \"options.jobs\"\n+prompt = \"Option for jobs (a ref, or none)\"\n+default = \"none\"\n+\n+[[ask]]\n+key = \"options.mail\"\n+prompt = \"Option for mail (a ref, or none)\"\n+default = \"none\"\n+\n+[[ask]]\n+key = \"options.browser\"\n+prompt = \"Option for browser (a ref, or none)\"\n+default = \"playwright@1\"\n+\n+[[ask]]\n+key = \"versions.postgres\"\n+prompt = \"Version of postgres\"\n+default = \"16\"\n+\n+[[ask]]\n+key = \"versions.redis\"\n+prompt = \"Version of redis\"\n+default = \"8\"\n+\n+[[ask]]\n+key = \"versions.rustfs\"\n+prompt = \"Version of rustfs\"\n+default = \"1.0.0-alpha.83\"\n+\n+[[ask]]\n+key = \"env.TZ\"\n+prompt = \"Value of TZ\"\n+default = \"Asia/Bangkok\"\n+\n+[[secret]]                 # a declaration: values live in podman secrets (D33)\n+name = \"twilio_auth_token\"\n+services = [\"rails\"]\n+env = \"TWILIO_AUTH_TOKEN\"\n","flags":[{"check":"firewall","line":0,"text":"firewall.allow.deps: (none) -\u003e github.com"},{"check":"privilege","line":0,"text":"secret.twilio_auth_token.env: (none) -\u003e TWILIO_AUTH_TOKEN"},{"check":"privilege","line":0,"text":"secret.twilio_auth_token.name: (none) -\u003e twilio_auth_token"},{"check":"privilege","line":0,"text":"secret.twilio_auth_token.services: (none) -\u003e rails"}]}]}],"restart":[],"warnings":[],"bundles_compared_with":{}}
