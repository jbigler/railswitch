["template","show","filial-stack@1"]
{"ref":"filial-stack@1","sha256":"9128d86c63291fb2192c99cae7226e9dea31336de353cd2289c6440495bef700","stack_toml":"schema = 1\nname = \"filial-stack\"\nversion = 1\nfresh_tasks = [\"test\"]\nterminal_tasks = [\"console\"]\n\n[stack]\npack = \"rails@1\"\napp = \"rails\"\n\n[options]                  # one per slot; \"none\" turns a slot off; another key adds a service of that name\ndatabase = \"postgres@1\"\ncache = \"redis@1\"\nstorage = \"rustfs@1\"\njobs = \"none\"\nmail = \"none\"\nbrowser = \"playwright@1\"\n\n[versions]                 # the options' image pins\npostgres = \"16\"\nredis = \"8\"\nrustfs = \"1.0.0-alpha.83\"\n\n[env]\nTZ = \"Asia/Bangkok\"\n\n[services.rails.env]\nHEADLESS_SYSTEM_TESTS = \"0\"\n\n[[links]]\nlabel = \"Admin\"\nurl = \"{worktree.host}/admin\"\n\n[firewall]\nallow.deps = [\"github.com\"]\n\n[[ask]]\nkey = \"options.database\"\nprompt = \"Option for database (a ref, or none)\"\ndefault = \"postgres@1\"\n\n[[ask]]\nkey = \"options.cache\"\nprompt = \"Option for cache (a ref, or none)\"\ndefault = \"redis@1\"\n\n[[ask]]\nkey = \"options.storage\"\nprompt = \"Option for storage (a ref, or none)\"\ndefault = \"rustfs@1\"\n\n[[ask]]\nkey = \"options.jobs\"\nprompt = \"Option for jobs (a ref, or none)\"\ndefault = \"none\"\n\n[[ask]]\nkey = \"options.mail\"\nprompt = \"Option for mail (a ref, or none)\"\ndefault = \"none\"\n\n[[ask]]\nkey = \"options.browser\"\nprompt = \"Option for browser (a ref, or none)\"\ndefault = \"playwright@1\"\n\n[[ask]]\nkey = \"versions.postgres\"\nprompt = \"Version of postgres\"\ndefault = \"16\"\n\n[[ask]]\nkey = \"versions.redis\"\nprompt = \"Version of redis\"\ndefault = \"8\"\n\n[[ask]]\nkey = \"versions.rustfs\"\nprompt = \"Version of rustfs\"\ndefault = \"1.0.0-alpha.83\"\n\n[[ask]]\nkey = \"env.TZ\"\nprompt = \"Value of TZ\"\ndefault = \"Asia/Bangkok\"\n\n[[secret]]                 # a declaration: values live in podman secrets (D33)\nname = \"twilio_auth_token\"\nservices = [\"rails\"]\nenv = \"TWILIO_AUTH_TOKEN\"\n","ask":[{"key":"options.database","prompt":"Option for database (a ref, or none)","default":"postgres@1"},{"key":"options.cache","prompt":"Option for cache (a ref, or none)","default":"redis@1"},{"key":"options.storage","prompt":"Option for storage (a ref, or none)","default":"rustfs@1"},{"key":"options.jobs","prompt":"Option for jobs (a ref, or none)","default":"none"},{"key":"options.mail","prompt":"Option for mail (a ref, or none)","default":"none"},{"key":"options.browser","prompt":"Option for browser (a ref, or none)","default":"playwright@1"},{"key":"versions.postgres","prompt":"Version of postgres","default":"16"},{"key":"versions.redis","prompt":"Version of redis","default":"8"},{"key":"versions.rustfs","prompt":"Version of rustfs","default":"1.0.0-alpha.83"},{"key":"env.TZ","prompt":"Value of TZ","default":"Asia/Bangkok"}],"secrets":["twilio_auth_token"],"containerfiles":[],"readme":"","files":[{"path":"stack.toml","text":"schema = 1\nname = \"filial-stack\"\nversion = 1\nfresh_tasks = [\"test\"]\nterminal_tasks = [\"console\"]\n\n[stack]\npack = \"rails@1\"\napp = \"rails\"\n\n[options]                  # one per slot; \"none\" turns a slot off; another key adds a service of that name\ndatabase = \"postgres@1\"\ncache = \"redis@1\"\nstorage = \"rustfs@1\"\njobs = \"none\"\nmail = \"none\"\nbrowser = \"playwright@1\"\n\n[versions]                 # the options' image pins\npostgres = \"16\"\nredis = \"8\"\nrustfs = \"1.0.0-alpha.83\"\n\n[env]\nTZ = \"Asia/Bangkok\"\n\n[services.rails.env]\nHEADLESS_SYSTEM_TESTS = \"0\"\n\n[[links]]\nlabel = \"Admin\"\nurl = \"{worktree.host}/admin\"\n\n[firewall]\nallow.deps = [\"github.com\"]\n\n[[ask]]\nkey = \"options.database\"\nprompt = \"Option for database (a ref, or none)\"\ndefault = \"postgres@1\"\n\n[[ask]]\nkey = \"options.cache\"\nprompt = \"Option for cache (a ref, or none)\"\ndefault = \"redis@1\"\n\n[[ask]]\nkey = \"options.storage\"\nprompt = \"Option for storage (a ref, or none)\"\ndefault = \"rustfs@1\"\n\n[[ask]]\nkey = \"options.jobs\"\nprompt = \"Option for jobs (a ref, or none)\"\ndefault = \"none\"\n\n[[ask]]\nkey = \"options.mail\"\nprompt = \"Option for mail (a ref, or none)\"\ndefault = \"none\"\n\n[[ask]]\nkey = \"options.browser\"\nprompt = \"Option for browser (a ref, or none)\"\ndefault = \"playwright@1\"\n\n[[ask]]\nkey = \"versions.postgres\"\nprompt = \"Version of postgres\"\ndefault = \"16\"\n\n[[ask]]\nkey = \"versions.redis\"\nprompt = \"Version of redis\"\ndefault = \"8\"\n\n[[ask]]\nkey = \"versions.rustfs\"\nprompt = \"Version of rustfs\"\ndefault = \"1.0.0-alpha.83\"\n\n[[ask]]\nkey = \"env.TZ\"\nprompt = \"Value of TZ\"\ndefault = \"Asia/Bangkok\"\n\n[[secret]]                 # a declaration: values live in podman secrets (D33)\nname = \"twilio_auth_token\"\nservices = [\"rails\"]\nenv = \"TWILIO_AUTH_TOKEN\"\n"}]}
